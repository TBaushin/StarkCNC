<Window x:Class="StarkCNC.Windows.AuthorizationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:StarkCNC.Controls"
        xmlns:utilities="clr-namespace:StarkCNC.Utilities;assembly=StarkCNC.Utilities"
        xmlns:local="clr-namespace:StarkCNC.Windows"
        mc:Ignorable="d"
        Title="AuthorizationWindow"
        Height="450"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        KeyDown="Window_KeyDown"
        Closing="Window_Closing">
    <Window.Resources>
        <utilities:BoolToVisibilityConverter x:Key="BoolToVisibilitConverter"/>
    </Window.Resources>
    <Grid
        RowDefinitions="*,Auto,Auto"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel
            Grid.Row="0"
            Margin="10">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Авторизация"
                Margin="0,0,0,10"/>
            <Border
                x:Name="ErrorsForm"
                Grid.Column="0"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                MinHeight="40"
                CornerRadius="5"
                Background="{StaticResource SystemFillColorCriticalBackgroundBrush}"
                Visibility="Collapsed">
                <Label
                    x:Name="ErrorsText"
                    Margin="5"
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>
            </Border>
            <Label
                Content="Введите ваши данные"/>
            <Grid RowDefinitions="Auto,Auto">
                <Label
                    Grid.Row="0"
                    Content="Имя пользователя"/>
                <ComboBox 
                    x:Name="Login"
                    Grid.Row="1"
                    IsEditable="True"
                    ItemsSource="{Binding Users}"/>
            </Grid>
            <Grid RowDefinitions="Auto,Auto">
                <Label
                    Grid.Row="0"
                    Content="Пароль"/>
                <controls:PasswordTextBox
                    x:Name="Password"
                    Grid.Row="1"
                    Margin="0,0,0,10"/>
            </Grid>
            <CheckBox
                x:Name="RememberAuth"
                Content="Запомнить вход"/>
        </StackPanel>
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            Visibility="{Binding CanCreateOrDeleteUsers, Converter={StaticResource BoolToVisibilitConverter}}">
            <Button
                Grid.Column="0"
                Margin="10,14,10,14"
                HorizontalAlignment="Stretch"
                Content="Создание пользователя"
                Click="RegisterUserButton_Click"/>
            <Button
                Grid.Column="1"
                Margin="10,14,10,14"
                HorizontalAlignment="Stretch"
                Content="Удаление выбранного пользователя"
                Click="DeleteButton_Click"/>
        </Grid>
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
            <Button
                Grid.Column="0"
                Margin="10,14,10,14"
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                Content="Войти"
                Click="AuthButton_Click"/>
            <Button
                Grid.Column="1"
                Margin="10,14,10,14"
                HorizontalAlignment="Stretch"
                Content="Отмена"
                Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
