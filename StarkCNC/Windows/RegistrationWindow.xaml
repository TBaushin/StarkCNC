<Window x:Class="StarkCNC.Windows.RegistrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StarkCNC.Windows"
        mc:Ignorable="d"
        Title="RegistrationWindow"
        Height="450"
        Width="400"
        ResizeMode="NoResize"
        Topmost="True"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        KeyDown="Window_KeyDown">
    <Grid
        RowDefinitions="*,Auto"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel
            Grid.Row="0"
            Margin="10">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Регистрация"
                Margin="0,0,0,10"/>
            <Border
                x:Name="ErrorsForm"
                Grid.Column="0"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                MinHeight="40"
                CornerRadius="5"
                Background="{StaticResource SystemFillColorCriticalBackgroundBrush}"
                Visibility="Collapsed">
                <Label
                    x:Name="ErrorsText"
                    Margin="5"
                    FontSize="16"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"/>
            </Border>
            <Label
                Content="Введите ваши данные"/>
            <Grid RowDefinitions="Auto,Auto">
                <Label
                    Grid.Row="0"
                    Content="Имя пользователя"/>
                <TextBox 
                    x:Name="Login"
                    Grid.Row="1"/>
            </Grid>
            <Grid RowDefinitions="Auto,Auto">
                <Label
                    Grid.Row="0"
                    Content="Пароль"/>
                <TextBox
                    x:Name="Password"
                    Grid.Row="1"
                    Margin="0,0,0,10"/>
            </Grid>
            <Grid RowDefinitions="Auto,Auto">
                <Label
                    Grid.Row="0"
                    Content="Роль пользователя"/>
                <ComboBox
                    x:Name="UserRole"
                    Grid.Row="1"
                    ItemsSource="{Binding AvailableRoles}"/>
            </Grid>
        </StackPanel>
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
            <Button
                Grid.Column="0"
                Margin="10,14,10,14"
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                Click="RegisterButton_Click">
                <StackPanel>
                    <TextBlock TextAlignment="Center">
                        Зарегистрировать
                        <LineBreak/>
                        пользователя
                    </TextBlock>
                </StackPanel>
            </Button>
            <Button
                Grid.Column="1"
                Margin="10,14,10,14"
                HorizontalAlignment="Stretch"
                Content="Отмена"
                Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
