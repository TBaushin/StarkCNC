<Page x:Class="StarkCNC.Views.UserView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:models="clr-namespace:StarkCNC.Models"
      xmlns:helpers="clr-namespace:StarkCNC.Helpers"
      xmlns:local="clr-namespace:StarkCNC.Views"
      xmlns:viewmodels="clr-namespace:StarkCNC.ViewModels"
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=viewmodels:UserViewModel}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="UserView">
    <Page.Resources>
        <helpers:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <helpers:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>
        <helpers:BytesToBitmapConverter x:Key="BytesToBitmapConverter"/>

        <Style TargetType="Label" x:Key="GenericLabelStyle">
            <Setter Property="Opacity" Value="0.67"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
    </Page.Resources>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MaxHeight="280"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="UserListGrid" Grid.Column="0" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListView
                x:Name="UserList"
                Grid.Row="0"
                Width="300"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                ItemsSource="{Binding Users, Mode=TwoWay}"
                SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:User}">
                        <Grid Margin="8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:PersonPicture
                                x:Name="PreviewUserPicture"
                                Grid.RowSpan="2"
                                Width="32"
                                Height="32"
                                Margin="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                PictureSource="{Binding Image, Converter={StaticResource BytesToBitmapConverter}}"
                                DisplayName="{Binding Name}"/>
                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="12,6,0,0"
                                Text="{Binding Name, Mode=OneWay}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Button
                x:Name="NewUserButton"
                Grid.Row="1"
                Margin="10"
                HorizontalAlignment="Center"
                Command="{Binding AddUserCommand}"
                Content="{x:Static lang:Language.AddNewUserButton}"
                Style="{DynamicResource AccentButtonStyle}"/>
        </Grid>

        <Grid x:Name="UserDetailsGrid" Grid.Column="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid
                x:Name="UserDetailHeader"
                Grid.Row="0"
                Margin="20,10,20,10"
                Visibility="{Binding SelectedUser, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <controls:PersonPicture
                    x:Name="EditableUserPicture"
                    Grid.Column="0"
                    Grid.Row="0"
                    Width="96"
                    Height="96"
                    Margin="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    PictureSource="{Binding SelectedUser.Image, Converter={StaticResource BytesToBitmapConverter}}"
                    DisplayName="{Binding SelectedUser.Name}"/>
                <StackPanel
                    x:Name="UserDetailHeaderPanel"
                    Grid.Column="1"
                    Grid.Row="0"
                    Orientation="Vertical"
                    VerticalAlignment="Center">
                    <Label Content="{x:Static lang:Language.Username}"/>
                    <TextBlock
                        x:Name="UserDetailHeaderNameBox"
                        FontSize="24"
                        Text="{Binding SelectedUser.Name}"/>
                </StackPanel>
                <Button Grid.Column="2" Grid.Row="1">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                Margin="0,4,0,0"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                FontSize="10"
                                Text="&#xE898;"/>
                            <TextBlock
                                Margin="8,0,0,0"
                                Text="{x:Static lang:Language.UploadImage}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>

            <Grid
                x:Name="UserDetailFormGrid"
                Grid.Row="1"
                Margin="20,10,20,10"
                Visibility="{Binding SelectedUser, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="1" Focusable="False">
                    <Grid Margin="20,0,20,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid x:Name="NameInputGrid" Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel
                                x:Name="FirstNamePanel"
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                Orientation="Vertical">
                                <Label
                                    Content="{x:Static lang:Language.Username}"
                                    Style="{StaticResource GenericLabelStyle}"
                                    FontWeight="SemiBold"/>
                                <TextBox
                                    Margin="0,5,0,15"
                                    Text="{Binding EditableUser.Name}"
                                    IsReadOnly="{Binding IsReadOnly}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Right" 
                            Orientation="Horizontal">
                            <Button
                                x:Name="EditButton"
                                Margin="10"
                                Command="{Binding EditUserStartCommand}"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="EditButton_Click"
                                Content="{x:Static lang:Language.EditButton}"/>
                            <Button
                                Margin="10"
                                Command="{Binding RemoveUserCommand}"
                                CommandParameter="{Binding SelectedUser}"
                                Visibility="{Binding IsReadOnly, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Content="{x:Static lang:Language.DeleteButton}"/>
                            <Button
                                x:Name="SaveButton"
                                Margin="10"
                                Command="{Binding EditUserCommitCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="SaveButton_Click"
                                Content="{x:Static lang:Language.SaveButton}"/>
                            <Button
                                Margin="10"
                                Command="{Binding EditUserCancelCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Click="CancelButton_Click"
                                Content="{x:Static lang:Language.CancelButton}"/>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
