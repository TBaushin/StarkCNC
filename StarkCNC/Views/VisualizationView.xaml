<Page x:Name="VisualizationPage"
      x:Class="StarkCNC.Views.VisualizationView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:helix="http://helix-toolkit.org/wpf/SharpDX"
      xmlns:local="clr-namespace:StarkCNC.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static lang:Language.VisualizationPageTitle}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border 
            Grid.Row="0" 
            Margin="10"
            Padding="5,5,5,5"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <helix:Viewport3DX 
                    x:Name="BendingView"
                    Grid.Column="0"
                    Background="Transparent"
                    BackgroundColor="Transparent"
                    Camera="{Binding Camera}"
                    EffectsManager="{Binding EffectsManager}"
                    EnableSwapChainRendering="True"
                    FXAALevel="Low"
                    FixedRotationPoint="{Binding ModelCentroid}"
                    FixedRotationPointEnabled="True">
                    <helix:Viewport3DX.InputBindings>
                        <MouseBinding
                            Command="helix:ViewportCommands.Rotate"
                            Gesture="RightClick"/>
                        <MouseBinding
                            Command="helix:ViewportCommands.Zoom"
                            Gesture="MiddleClick"/>
                        <MouseBinding
                            Command="helix:ViewportCommands.Pan"
                            Gesture="LeftClick"/>
                    </helix:Viewport3DX.InputBindings>
                    <helix:ScreenQuadModel3D Texture="{Binding TextureModel}" Depth="1"/>
                    <helix:AmbientLight3D Color="#363636"/>
                    <helix:DirectionalLight3D
                        Direction="{Binding Camera.LookDirection}"
                        Color="#D6D6D6"/>
                    <helix:EnvironmentMap3D
                        IsRendering="{Binding RenderEnvironmentMap}"
                        Texture="{Binding EnvironmentMap}"/>
                    <helix:Element3DPresenter Content="{Binding GroupModel}"/>
                    <helix:PostEffectMeshBorderHighlight EffectName="highlight"/>
                </helix:Viewport3DX>
                <StackPanel
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="10,0,10,0"
                    Orientation="Vertical">
                    <Button
                        x:Name="ZoomIn"
                        Margin="0,0,0,10"
                        Click="ZoomIn_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE8A3;"/>
                    </Button>
                    <Button
                        x:Name="ZoomOut"
                        Margin="0,0,0,10"
                        Click="ZoomOut_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE71F;"/>
                    </Button>
                    <Button
                        x:Name="Update"
                        Margin="0,0,0,10"
                        Click="StartAnimation_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE75F;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Visible"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
                <Label Content="{x:Static lang:Language.Console}"/>
                <Slider
                    x:Name="ConsoleSlider"
                    Maximum="300"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    Value="{Binding Console, Mode=TwoWay}"/>
                <Separator/>
                <Label Content="{x:Static lang:Language.Bend}"/>
                <Slider
                    x:Name="BendSlider"
                    Maximum="195"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    Value="{Binding Bend, Mode=TwoWay}"/>
                <Separator/>
                <Label Content="{x:Static lang:Language.Supply}"/>
                <Slider
                    x:Name="SupplySlider"
                    Maximum="3000"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    Value="{Binding Supply, Mode=TwoWay}"/>
                <Separator/>
                <Label Content="{x:Static lang:Language.Height}"/>
                <Slider
                    x:Name="HeightSlider"
                    Maximum="180"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    Value="{Binding Height, Mode=TwoWay}"/>
                <Separator/>
                <Label Content="{x:Static lang:Language.Clamp}"/>
                <Slider
                    x:Name="ClampSlider"
                    Maximum="100"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    Value="{Binding Clamp, Mode=TwoWay}"/>
                <Separator/>
                <Label Content="{x:Static lang:Language.Press}"/>
                <Slider
                    x:Name="PressSlider"
                    Maximum="100"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    Value="{Binding Press, Mode=TwoWay}"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

