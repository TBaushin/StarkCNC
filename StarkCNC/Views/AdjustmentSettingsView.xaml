<Page x:Class="StarkCNC.Views.AdjustmentSettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:local="clr-namespace:StarkCNC.Views"
      d:DataContext="{d:DesignInstance vm:AdjustmentViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdjustmentSettingsView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <controls:LabeledTextBoxControl
                Grid.Column="0"
                HorizontalAlignment="Center"
                Width="250"
                LabelText="{x:Static lang:Language.Name}"
                TextBoxText="{Binding SelectedAdjustment.Name, Mode=TwoWay}"/>
            <controls:LabeledTextBoxControl
                Grid.Column="1"
                HorizontalAlignment="Center"
                Width="250"
                NeedCallNumberInput="True"
                IsNumericOnly="True"
                LabelText="{x:Static lang:Language.PipeDiameter}"
                TextBoxText="{Binding SelectedAdjustment.PipeDiameter}"/>

            <Grid
                Grid.Column="2"
                HorizontalAlignment="Center"
                Width="250">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label
                    Grid.Row="0"
                    Content="{x:Static lang:Language.LevelsCount}"/>
                <ComboBox
                    Grid.Row="1"
                    ItemsSource="{Binding AdjustmentsString}"
                    SelectedItem="{Binding SelectedAdjustment.Type}">
                </ComboBox>
            </Grid>
        </Grid>
        <Button
            Grid.Row="2"
            HorizontalAlignment="Center"
            Margin="0,0,0,10"
            Command="{Binding SaveAdjustmentCommand}">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    Text="&#xE73E;"/>
                <TextBlock 
                    Margin="8,0,0,0"
                    Text="{x:Static lang:Language.SaveButton}"/>
            </StackPanel>
        </Button>
    </Grid>
</Page>
