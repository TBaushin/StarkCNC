<Page x:Class="StarkCNC.Views.PreviewFileSectorView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helix="http://helix-toolkit.org/wpf/SharpDX"
      xmlns:local="clr-namespace:StarkCNC.Views"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PreviewFileSectorView">

    <Grid ColumnDefinitions="1.5*,*" RowDefinitions="*,Auto">
        <ListView
            Grid.Column="0"
            Grid.Row="0"
            ItemsSource="{Binding CurrentFolderContent}"
            PreviewMouseDoubleClick="ListView_PreviewMouseDoubleClick"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            FontSize="18"
                            FontFamily="{DynamicResource SymbolThemeFontFamily}"
                            Content="{Binding Icon}"/>
                        <Label
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Content="{Binding Name}"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid
            Grid.Column="0"
            Grid.Row="1"
            ColumnDefinitions="Auto,*,Auto">
            <Label
                Grid.Column="0"
                Margin="5"
                VerticalAlignment="Center"
                Content="Название файла:"/>
            <TextBox
                Grid.Column="1"
                Margin="5"
                Text="{Binding SelectedItem.Name}"/>
            <Button
                Grid.Column="2"
                Margin="5"
                Content="Выбрать"
                Command="{Binding SelectFolderCommand}"/>
        </Grid>
        <helix:Viewport3DX 
            x:Name="BendingView"
            Grid.Column="1"
            Grid.RowSpan="2"
            BackgroundColor="#595959"
            Camera="{Binding Camera}"
            EffectsManager="{Binding EffectsManager}"
            EnableSwapChainRendering="True"
            FXAALevel="Low"
            FixedRotationPoint="{Binding ModelCentroid}"
            FixedRotationPointEnabled="True">
            <helix:Viewport3DX.InputBindings>
                <MouseBinding
                    Command="helix:ViewportCommands.Rotate"
                    Gesture="RightClick"/>
                <MouseBinding
                    Command="helix:ViewportCommands.Zoom"
                    Gesture="MiddleClick"/>
                <MouseBinding
                    Command="helix:ViewportCommands.Pan"
                    Gesture="LeftClick"/>
            </helix:Viewport3DX.InputBindings>
            <helix:AmbientLight3D Color="#363636"/>
            <helix:DirectionalLight3D
                Direction="{Binding Camera.LookDirection}"
                Color="#D6D6D6"/>
            <helix:EnvironmentMap3D
                IsRendering="{Binding RenderEnvironmentMap}"
                Texture="{Binding EnvironmentMap}"/>
            <helix:Element3DPresenter Content="{Binding Pipe}"/>
            <helix:PostEffectMeshBorderHighlight EffectName="highlight"/>
        </helix:Viewport3DX>
    </Grid>
</Page>
