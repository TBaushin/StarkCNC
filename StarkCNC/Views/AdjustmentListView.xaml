<Page x:Class="StarkCNC.Views.AdjustmentListView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      xmlns:sys="clr-namespace:System;assembly=System.Runtime"
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:local="clr-namespace:StarkCNC.Views"
      d:DataContext="{d:DesignInstance vm:AdjustmentViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdjustmentListView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Button
                x:Name="AddAdjustment"
                Command="{Binding CreateAdjustmentCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock 
                        VerticalAlignment="Center"
                        Margin="0,4,0,0"
                        FontSize="10"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Text="&#xE710;"/>
                    <TextBlock 
                        Margin="8,0,0,0" 
                        Text="{x:Static lang:Language.AddButton}"/>
                </StackPanel>
            </Button>
        </Grid>
        <ListView
            Grid.Row="1"
            ItemsSource="{Binding Adjustments}"
            SelectionChanged="ListView_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="8,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock             
                            Grid.Row="0"             
                            Grid.Column="0"             
                            Margin="12,6,0,0"             
                            FontWeight="Bold"             
                            Text="{Binding Name, Mode=OneWay}"/>
                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                            <Button
                                Margin="10,0,10,0"
                                Visibility="Collapsed"
                                Command="{Binding DataContext.EditAdjustmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock 
                                        VerticalAlignment="Center"
                                        Margin="0,4,0,0"
                                        FontSize="10"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        Text="&#xE70F;"/>
                                    <TextBlock 
                                        Margin="8,0,0,0" 
                                        Text="{x:Static lang:Language.EditButton}"/>
                                </StackPanel>
                            </Button>
                            <Button
                                Margin="10,0,10,0"
                                Visibility="Collapsed"
                                Command="{Binding DataContext.DeleteAdjustmentCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock 
                                        VerticalAlignment="Center"
                                        Margin="0,4,0,0"
                                        FontSize="10"
                                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                                        Text="&#xE74D;"/>
                                    <TextBlock 
                                        Margin="8,0,0,0" 
                                        Text="{x:Static lang:Language.DeleteButton}"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
