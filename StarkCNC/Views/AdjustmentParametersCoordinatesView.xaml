<Page x:Class="StarkCNC.Views.AdjustmentParametersCoordinatesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
      xmlns:local="clr-namespace:StarkCNC.Views"
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      d:DataContext="{d:DesignInstance vm:AdjustmentParametersCoordinatesViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AdjustmentParametersCoordinatesView">

    <ScrollViewer>
        <StackPanel Orientation="Vertical">
            <Border
                x:Name="Supply"
                Margin="8,4,8,4"
                MinHeight="80"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <svg:SvgViewbox
                        Grid.Column="0"
                        Width="64"
                        Height="64"
                        Margin="0,0,10,0"
                        Source="Resources/Icons/supply.svg"/>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Vertical">
                        <Label FontSize="20">
                            <TextBlock>
                                <Run Text="Подача"/>
                                <Run
                                    FontFamily="pack://application:,,,/Resources/Fonts/#ADLaM Display"
                                    Text="Y"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Положение зоны прижима:"/>
                                <Run Text="{Binding Supply.PressZonePosition}"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Положение передней опасной зоны:"/>
                                <Run Text="{Binding Supply.ForwardDangerZonePosition}"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Глубина губок цанги:"/>
                                <Run Text="{Binding Supply.ColletJawsDepth}"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Коэффициент скорости:"/>
                                <Run Text="{Binding Supply.SpeedCoefficient}"/>
                            </TextBlock>
                        </Label>
                    </StackPanel>
                    <Button
                        x:Name="SupplyEditButton"
                        Grid.Column="2"
                        Click="EditButton_Click"
                        Content="Редактировать"/>
                </Grid>
            </Border>
            <Border
                x:Name="Console"
                Margin="8,4,8,4"
                MinHeight="80"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <svg:SvgViewbox
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,10,0"
                        Source="Resources/Icons/console.svg"/>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Vertical">
                        <Label FontSize="20">
                            <TextBlock>
                                <Run Text="Консоль"/>
                                <Run
                                    FontFamily="pack://application:,,,/Resources/Fonts/#ADLaM Display"
                                    Text="X"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Положение консоли для гибки:"/>
                                <Run Text="{Binding Console.BendPosition}"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Положение консоли при переходе с 1 на 2 этаж:"/>
                                <Run Text="{Binding Console.SecondFloorPosition}"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Положение консоли при переходе с 2 на 3 этаж:"/>
                                <Run/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Расстояние отъезда для поворота трубы:"/>
                                <Run Text="{Binding Console.PipeRotationDepartureDistance}"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Коэффициент скорости:"/>
                                <Run Text="{Binding Console.SpeedCoefficient}"/>
                            </TextBlock>
                        </Label>
                    </StackPanel>
                    <Button
                        x:Name="ConsoleEditButton"
                        Grid.Column="2"
                        Click="EditButton_Click"
                        Content="Редактировать"/>
                </Grid>
            </Border>
            <Border
                x:Name="Rotation"
                Margin="8,4,8,4"
                MinHeight="80"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <svg:SvgViewbox
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,10,0"
                        Source="Resources/Icons/clamp-length-2.svg"/>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Vertical">
                        <Label FontSize="20">
                            <TextBlock>
                                <Run Text="Поворот"/>
                                <Run
                                    FontFamily="pack://application:,,,/Resources/Fonts/#ADLaM Display"
                                    Text="C"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Смещение поворота после поиска нуля:"/>
                                <Run Text="{Binding Rotation.OffsetAfterZeroSearch}"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Коэффициент скорости:"/>
                                <Run Text="{Binding Rotation.SpeedCoefficient}"/>
                            </TextBlock>
                        </Label>
                    </StackPanel>
                    <Button
                        x:Name="RotationEditButton"
                        Grid.Column="2"
                        Click="EditButton_Click"
                        Content="Редактировать"/>
                </Grid>
            </Border>
            <Border
                x:Name="Bend"
                Margin="8,4,8,4"
                MinHeight="80"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <svg:SvgViewbox
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Margin="0,0,10,0"
                        Source="Resources/Icons/clamp-length-2.svg"/>
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Vertical">
                        <Label FontSize="20">
                            <TextBlock>
                                <Run Text="Гиб"/>
                                <Run
                                    FontFamily="pack://application:,,,/Resources/Fonts/#ADLaM Display"
                                    Text="B"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Ограничение переднего положения:"/>
                                <Run Text="{Binding Bend.ForwardPositionLimitation}"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Коэффициент скорости:"/>
                                <Run Text="{Binding Bend.SpeedCoefficient}"/>
                            </TextBlock>
                        </Label>
                        <Label>
                            <TextBlock>
                                <Run Text="Скорость замедления:"/>
                                <Run Text="{Binding Bend.SlowdownSpeed}"/>
                            </TextBlock>
                        </Label>
                    </StackPanel>
                    <Button
                        x:Name="BendEditButton"
                        Grid.Column="2"
                        Click="EditButton_Click"
                        Content="Редактировать"/>
                </Grid>
            </Border>
            <StackPanel> <!--TODO: Привязать visibility к типу станка - электрический-->
                <Border
                    x:Name="Squeeze"
                    Margin="8,4,8,4"
                    MinHeight="80"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <svg:SvgViewbox
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,10,0"
                            Source="Resources/Icons/clamp-length-2.svg"/>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Vertical">
                            <Label
                                FontSize="20"
                                Content="Дожим"/>
                            <Label>
                                <TextBlock>
                                    <Run Text="Ограничение переднего положения:"/>
                                    <Run Text="{Binding Squeeze.FrontPositionLimitation}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Коэффициент скорости:"/>
                                    <Run Text="{Binding Squeeze.SpeedCoefficient}"/>
                                </TextBlock>
                            </Label>
                        </StackPanel>
                        <Button
                            x:Name="SqueezeEditButton"
                            Grid.Column="2"
                            Click="EditButton_Click"
                            Content="Редактировать"/>
                    </Grid>
                </Border>
                <Border
                    x:Name="Clamp"
                    Margin="8,4,8,4"
                    MinHeight="80"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <svg:SvgViewbox
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,10,0"
                            Source="Resources/Icons/clamp-length-2.svg"/>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Vertical">
                            <Label
                                FontSize="20"
                                Content="Зажим"/>
                            <Label>
                                <TextBlock>
                                    <Run Text="Переднее положение:"/>
                                    <Run Text="{Binding Clamp.ForwardPosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Среднее положение:"/>
                                    <Run Text="{Binding Clamp.MiddlePosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Заднее положение:"/>
                                    <Run Text="{Binding Clamp.BackwardPosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Коэффициент скорости:"/>
                                    <Run Text="{Binding Clamp.SpeedCoefficient}"/>
                                </TextBlock>
                            </Label>
                        </StackPanel>
                        <Button
                            x:Name="ClampEditButton"
                            Grid.Column="2"
                            Click="EditButton_Click"
                            Content="Редактировать"/>
                    </Grid>
                </Border>
                <Border
                    x:Name="Press"
                    Margin="8,4,8,4"
                    MinHeight="80"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <svg:SvgViewbox
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,10,0"
                            Source="Resources/Icons/clamp-length-2.svg"/>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Vertical">
                            <Label
                                FontSize="20"
                                Content="Прижим"/>
                            <Label>
                                <TextBlock>
                                    <Run Text="Переднее положение:"/>
                                    <Run Text="{Binding Press.ForwardPosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Среднее положение:"/>
                                    <Run Text="{Binding Press.MiddlePosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Заднее положение:"/>
                                    <Run Text="{Binding Press.BackwardPosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Коэффициент скорости:"/>
                                    <Run Text="{Binding Press.SpeedCoefficient}"/>
                                </TextBlock>
                            </Label>
                        </StackPanel>
                        <Button
                            x:Name="PressEditButton"
                            Grid.Column="2"
                            Click="EditButton_Click"
                            Content="Редактировать"/>
                    </Grid>
                </Border>
                <Border
                    x:Name="Dorn"
                    Margin="8,4,8,4"
                    MinHeight="80"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <svg:SvgViewbox
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,10,0"
                            Source="Resources/Icons/clamp-length-2.svg"/>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Vertical">
                            <Label
                                FontSize="20"
                                Content="Дорн"/>
                            <Label>
                                <TextBlock>
                                    <Run Text="Переднее положение:"/>
                                    <Run Text="{Binding Dorn.ForwardPosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Среднее положение:"/>
                                    <Run Text="{Binding Dorn.MiddlePosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Заднее положение:"/>
                                    <Run Text="{Binding Dorn.BackwardPosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Коэффициент скорости:"/>
                                    <Run Text="{Binding Dorn.SpeedCoefficient}"/>
                                </TextBlock>
                            </Label>
                        </StackPanel>
                        <Button
                            x:Name="DornEditButton"
                            Grid.Column="2"
                            Click="EditButton_Click"
                            Content="Редактировать"/>
                    </Grid>
                </Border>
                <Border
                    x:Name="Lift"
                    Margin="8,4,8,4"
                    MinHeight="80"
                    CornerRadius="4"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid
                        Grid.Column="0"
                        Margin="10,0,10,0"
                        VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <svg:SvgViewbox
                            Grid.Column="0"
                            Width="32"
                            Height="32"
                            Margin="0,0,10,0"
                            Source="Resources/Icons/clamp-length-2.svg"/>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Vertical">
                            <Label
                                FontSize="20"
                                Content="Подъём"/>
                            <Label>
                                <TextBlock>
                                    <Run Text="Верхнее положение:"/>
                                    <Run Text="{Binding Lift.UpperPosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Среднее положение:"/>
                                    <Run Text="{Binding Lift.MiddlePosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Нижнее положение:"/>
                                    <Run Text="{Binding Lift.LowerPosition}"/>
                                </TextBlock>
                            </Label>
                            <Label>
                                <TextBlock>
                                    <Run Text="Коэффициент скорости:"/>
                                    <Run Text="{Binding Lift.SpeedCoefficient}"/>
                                </TextBlock>
                            </Label>
                        </StackPanel>
                        <Button
                            x:Name="LiftEditButton"
                            Grid.Column="2"
                            Click="EditButton_Click"
                            Content="Редактировать"/>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
