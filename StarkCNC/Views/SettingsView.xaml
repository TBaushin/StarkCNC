<Page x:Class="StarkCNC.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:local="clr-namespace:StarkCNC.Views"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SettingsView">
    <Page.Resources>
        <ResourceDictionary>
            <Style TargetType="controls:LabeledTextBoxControl">
                <Setter Property="MinWidth" Value="55"/>
                <Setter Property="IsNumericOnly" Value="True"/>
                <Setter Property="NeedCallNumberInput" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid RowDefinitions="Auto,0.67*,*,0.65*">
        <Label
            Grid.Row="0"
            Margin="10,5,0,5"
            Content="Основные настройки"/>
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,*,*">
            <controls:BorderedControl
                Grid.Column="0"
                Margin="0,0,-4,0"
                ChangeColorOnHover="False">
                <StackPanel
                    Margin="5,0,5,0"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Content="Дорн"/>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsFirst="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto,Auto">
                            <Label
                                Grid.Column="0"
                                Grid.Row="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Выдвижение дорна в автомате"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Margin="5"
                                Command="{Binding DornAutomaticSendCommand}"
                                IsChecked="{Binding DornAutomatic, Mode=TwoWay}"/>
                            <controls:LabeledTextBoxControl
                                Grid.Column="2"
                                MaxWidth="120"
                                Direction="TopToBottom"
                                Command="{Binding DornLeadWithdrawalBeforeBendSendCommand}"
                                Text="{Binding DornLeadWithdrawalBeforeBend, Mode=TwoWay}">
                                <controls:LabeledTextBoxControl.LabelText>
                                    <TextBlock
                                        TextWrapping="WrapWithOverflow"
                                        Text="Опережение дорна (градусы)"/>
                                </controls:LabeledTextBoxControl.LabelText>
                            </controls:LabeledTextBoxControl>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        MinHeight="50"
                        IsOneBorder="True"
                        IsLast="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Смазка дорна в автомате"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Command="{Binding DornLubricantTurnOnSendCommand}"
                                IsChecked="{Binding DornLubricantTurnOn, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                </StackPanel>
            </controls:BorderedControl>
            <controls:BorderedControl
                Grid.Column="1"
                Margin="-4,0,-4,0"
                ChangeColorOnHover="False">
                <StackPanel
                    Margin="5,0,5,0"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Content="Настройки гибки"/>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsFirst="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Принудительное проталкивание трубы при гибке в автомате"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Margin="5"
                                Command="{Binding BendSynchronizationSendCommand}"
                                IsChecked="{Binding BendSynchronization, Mode=TwoWay}"/>
                            <controls:LabeledTextBoxControl
                                Grid.Column="2"
                                Direction="TopToBottom"
                                LabelText="Коэффициент"
                                Command="{Binding BendSynchronizationCoefficientSendCommand}"
                                Text="{Binding BendSynchronizationCoefficient, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsLast="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Синхронизация гиба и подачи в наладке"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Command="{Binding BendAndSupplySynchronizationSendCommand}"
                                IsChecked="{Binding BendAndSupplySynchronization, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                </StackPanel>
            </controls:BorderedControl>
            <controls:BorderedControl
                Grid.Column="2"
                Margin="-4,0,0,0"
                ChangeColorOnHover="False">
                <StackPanel
                    Margin="5,0,5,0"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Content="Настройки позиционирования"/>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsFirst="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,0.25*,0.13*">
                            <Label
                                Grid.Column="0"
                                Grid.Row="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Режим перехвтата (трубы выставляется по торцу зажима)"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Grid.Row="0"
                                Margin="5"
                                Command="{Binding InterceptionModeSendCommand}"
                                IsChecked="{Binding InterceptionMode, Mode=TwoWay}"/>
                            <Button
                                Grid.Column="2"
                                Grid.Row="0">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Margin="0,4,0,0"
                                    FontSize="10"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Text="&#xE8F2;"/>
                            </Button>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsLast="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,0.25*,0.13*">
                            <Label
                                Grid.Column="0"
                                Grid.Row="1">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Смещение консоли для установки трубы"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Grid.Row="1"
                                Margin="5"
                                Command="{Binding ConsoleOutletForPipeInstallingSendCommand}"
                                IsChecked="{Binding ConsoleOutletForPipeInstalling, Mode=TwoWay}"/>
                            <Button
                                Grid.Column="2"
                                Grid.Row="1">
                                <TextBlock 
                                    VerticalAlignment="Center"
                                    Margin="0,4,0,0"
                                    FontSize="10"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Text="&#xE8F2;"/>
                            </Button>
                        </Grid>
                    </controls:BorderedControl>
                </StackPanel>
            </controls:BorderedControl>
        </Grid>
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*,*">
            <controls:BorderedControl
                Grid.Column="0"
                Margin="0,0,-4,0"
                ChangeColorOnHover="False">
                <StackPanel
                    Margin="5,0,5,0"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Content="Конфигурация"/>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsFirst="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Grid.Row="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Координата выхода трубы"/>
                            </Label>
                            <controls:LabeledTextBoxControl
                                Grid.Column="1"
                                Grid.Row="0"
                                Command="{Binding PipeOutletCoordinateSendCommand}"
                                Text="{Binding PipeOutletCoordinate, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" MinHeight="33" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Многоуровневый станок"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Command="{Binding MultiLeveledSendCommand}"
                                IsChecked="{Binding MultiLeveled, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" MinHeight="33" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="С пробивочным цилиндром"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Command="{Binding WithPunchingCylinderSendCommand}"
                                IsChecked="{Binding WithPunchingCylinder, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" MinHeight="33" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Расстояние от оси гиба до штока пробивки"/>
                            </Label>
                            <controls:LabeledTextBoxControl
                                Grid.Column="1"
                                Command="{Binding DistanceFromBendingToPunchingSendCommand}"
                                Text="{Binding DistanceFromBendingToPunching, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" MinHeight="33" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Полностью электрический"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Command="{Binding IsElectricBendingDriveSendCommand}"
                                IsChecked="{Binding IsElectricBendingDrive, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsLast="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" MinHeight="33" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Абсолютные координаты узлов"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Command="{Binding AbsoluteUnitCoordinateSendCommand}"
                                IsChecked="{Binding AbsoluteUnitCoordinate, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                </StackPanel>
            </controls:BorderedControl>
            <controls:BorderedControl
                Grid.Column="1"
                Margin="-4,0,-4,0"
                ChangeColorOnHover="False">
                <StackPanel
                    Margin="5,0,5,0"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Content="Настройки поддержки"/>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsFirst="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Координата запрета подъёма переднего ролика поддержки, мм"/>
                            </Label>
                            <controls:LabeledTextBoxControl
                                Grid.Column="1"
                                Command="{Binding SupportFirstLiftBanSendCommand}"
                                Text="{Binding SupportFirstLiftBan, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Координата запрета подъёма 2 ролика поддержки, мм"/>
                            </Label>
                            <controls:LabeledTextBoxControl
                                Grid.Column="1"
                                Command="{Binding SupportSecondLiftBanSendCommand}"
                                Text="{Binding SupportSecondLiftBan, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Координата запрета подъёма 3 ролика поддержки, мм"/>
                            </Label>
                            <controls:LabeledTextBoxControl
                                Grid.Column="1"
                                Direction="TopToBottom"
                                LabelText="Сзади"
                                Command="{Binding SupportThirdLiftBanRearSendCommand}"
                                Text="{Binding SupportThirdLiftBanRear, Mode=TwoWay}"/>
                            <controls:LabeledTextBoxControl
                                Grid.Column="2"
                                Direction="TopToBottom"
                                LabelText="Впереди"
                                Command="{Binding SupportThirdLiftBanFrontSendCommand}"
                                Text="{Binding SupportThirdLiftBanFront, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Координата запрета подъёма 4 ролика поддержки, мм"/>
                            </Label>
                            <controls:LabeledTextBoxControl
                                Grid.Column="1"
                                Command="{Binding SupportFourthLiftBanSendCommand}"
                                Text="{Binding SupportFourthLiftBan, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsLast="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" MinHeight="33" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Запрет прижима при поднятой поддержке"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Command="{Binding BanPressWhenSupportIsLiftedSendCommand}"
                                IsChecked="{Binding BanPressWhenSupportIsLifted, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                </StackPanel>
            </controls:BorderedControl>
            <controls:BorderedControl
                Grid.Column="2"
                Margin="-4,0,0,0"
                ChangeColorOnHover="False">
                <StackPanel
                    Margin="5,0,5,0"
                    Orientation="Vertical">
                    <Label
                        HorizontalAlignment="Center"
                        FontSize="16"
                        Content="Доп настройки"/>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsFirst="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Время работы дожима назад после срабатывания датчика, с"/>
                            </Label>
                            <controls:LabeledTextBoxControl
                                Grid.Column="1"
                                Command="{Binding SqueezeWorkTimeSendCommand}"
                                Text="{Binding SqueezeWorkTime, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Скорость подачи при выходе гиба на угол для прокатки"/>
                            </Label>
                            <controls:LabeledTextBoxControl
                                Grid.Column="1"
                                Command="{Binding SupplyStartRollingSpeedSendCommand}"
                                Text="{Binding SupplyStartRollingSpeed, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" MinHeight="33" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Движение прижима на неполный ход"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Command="{Binding IncompleteClampMovementSendCommand}"
                                IsChecked="{Binding IncompleteClampMovement, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" MinHeight="33" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Движение гидравлики без датчиков"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Command="{Binding HydraulicMovementWithoutSensorsSendCommand}"
                                IsChecked="{Binding HydraulicMovementWithoutSensors, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" MinHeight="33" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Отображать кнопку &quot;Полный автомат&quot;"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Command="{Binding ShowButtonFullAutomaticSendCommand}"
                                IsChecked="{Binding ShowButtonFullAutomatic, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                    <controls:BorderedControl
                        IsOneBorder="True"
                        IsLast="True"
                        ChangeColorOnHover="True">
                        <Grid Margin="5" MinHeight="33" ColumnDefinitions="*,Auto">
                            <Label
                                Grid.Column="0"
                                Grid.Row="5"
                                VerticalAlignment="Center">
                                <TextBlock
                                    TextWrapping="WrapWithOverflow"
                                    Text="Инвертирование датчиков зажима"/>
                            </Label>
                            <controls:ToggleSwitchControl
                                Grid.Column="1"
                                Grid.Row="5"
                                Command="{Binding InvertClampSensorsSendCommand}"
                                IsChecked="{Binding InvertClampSensors, Mode=TwoWay}"/>
                        </Grid>
                    </controls:BorderedControl>
                </StackPanel>
            </controls:BorderedControl>
        </Grid>
        <Grid
            Grid.Row="3"
            Margin="0,5,0,0"
            ColumnDefinitions="*,*,*">
            <Grid
                Grid.Column="0"
                Grid.Row="0"
                Margin="8,0,4,5"
                ColumnDefinitions="0.2*,*"
                RowDefinitions="Auto,*,*,*,*">
                <!--Левые заголовки таблицы-->
                <Label
                    Grid.Column="0"
                    Grid.Row="1"
                    VerticalAlignment="Center"
                    Content="Подача"/>
                <Label
                    Grid.Column="0"
                    Grid.Row="2"
                    VerticalAlignment="Center"
                    Content="Поворот"/>
                <Label
                    Grid.Column="0"
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    Content="Консоль"/>
                <Label
                    Grid.Column="0"
                    Grid.Row="4"
                    VerticalAlignment="Center"
                    Content="Гиб"/>

                <!--Первый верхний заголовок таблицы-->
                <Label
                    Grid.Column="1"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Коэффициент скорости"/>

                <!--Контент-->
                <Border
                    Grid.Column="1"
                    Grid.Row="1"
                    Grid.RowSpan="4"
                    CornerRadius="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    Command="{Binding SupplyCoefficientSendCommand}"
                    Text="{Binding SupplyCoefficient, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Grid.Row="2"
                    Margin="5,0,5,0"
                    Command="{Binding RotationCoefficientSendCommand}"
                    Text="{Binding RotationCoefficient, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Grid.Row="3"
                    Margin="5,0,5,0"
                    Command="{Binding ConsoleCoefficientSendCommand}"
                    Text="{Binding ConsoleCoefficient, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Grid.Row="4"
                    Margin="5,0,5,0"
                    Command="{Binding BendCoefficientSendCommand}"
                    Text="{Binding BendCoefficient, Mode=TwoWay}"/>
            </Grid>
            <Grid
                Grid.Column="1"
                Margin="4,0,4,5"
                ColumnDefinitions="*,*,*"
                RowDefinitions="Auto,*,*,*,*">

                <!--Верхние заголовки таблицы-->
                <Label
                    Grid.Column="0"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Ускорение"/>
                <Label
                    Grid.Column="1"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Торможение"/>
                <Label
                    Grid.Column="2"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="Jerk"/>

                <!--Контент-->
                <Border
                    Grid.Column="0"
                    Grid.Row="1"
                    Grid.RowSpan="4"
                    CornerRadius="4,0,0,4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="0"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    Command="{Binding SupplyAccelerationSendCommand}"
                    Text="{Binding SupplyAcceleration, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="0"
                    Grid.Row="2"
                    Margin="5,0,5,0"
                    Command="{Binding RotationAccelerationSendCommand}"
                    Text="{Binding RotationAcceleration, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="0"
                    Grid.Row="3"
                    Margin="5,0,5,0"
                    Command="{Binding ConsoleAccelerationSendCommand}"
                    Text="{Binding ConsoleAcceleration, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="0"
                    Grid.Row="4"
                    Margin="5,0,5,0"
                    Command="{Binding BendAccelerationSendCommand}"
                    Text="{Binding BendAcceleration, Mode=TwoWay}"/>

                <Border
                    Grid.Column="1"
                    Grid.Row="1"
                    Grid.RowSpan="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    Command="{Binding SupplyBrakingSendCommand}"
                    Text="{Binding SupplyBraking, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Grid.Row="2"
                    Margin="5,0,5,0"
                    Command="{Binding RotationBrakingSendCommand}"
                    Text="{Binding RotationBraking, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Grid.Row="3"
                    Margin="5,0,5,0"
                    Command="{Binding ConsoleBrakingSendCommand}"
                    Text="{Binding ConsoleBraking, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Grid.Row="4"
                    Margin="5,0,5,0"
                    Command="{Binding BendBrakingSendCommand}"
                    Text="{Binding BendBraking, Mode=TwoWay}"/>

                <Border
                    Grid.Column="2"
                    Grid.Row="1"
                    Grid.RowSpan="4"
                    CornerRadius="0,4,4,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="2"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    Command="{Binding SupplyJerkSendCommand}"
                    Text="{Binding SupplyJerk, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="2"
                    Grid.Row="2"
                    Margin="5,0,5,0"
                    Command="{Binding RotationJerkSendCommand}"
                    Text="{Binding RotationJerk, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="2"
                    Grid.Row="3"
                    Margin="5,0,5,0"
                    Command="{Binding ConsoleJerkSendCommand}"
                    Text="{Binding ConsoleJerk, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="2"
                    Grid.Row="4"
                    Margin="5,0,5,0"
                    Command="{Binding BendJerkSendCommand}"
                    Text="{Binding BendJerk, Mode=TwoWay}"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
