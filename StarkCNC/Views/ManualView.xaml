<Page x:Class="StarkCNC.Views.ManualView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:local="clr-namespace:StarkCNC.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static lang:Language.ManualPageTitle}">
    <Page.Resources>
        <Style TargetType="controls:RepeatButtonWithIndicator">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid
            Grid.Column="0"
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,5,0,5"
                Content="Ручной режим"/>
            <controls:RepeatButtonWithIndicator
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Margin="0,5,0,5">
                <controls:RepeatButtonWithIndicator.ButtonContent>
                    <StackPanel>
                        <Label HorizontalAlignment="Center" Content="Гидравлика 1"/>
                        <Label HorizontalAlignment="Center" Content="Включить"/>
                    </StackPanel>
                </controls:RepeatButtonWithIndicator.ButtonContent>
            </controls:RepeatButtonWithIndicator>
            <controls:RepeatButtonWithIndicator
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                Margin="0,5,0,5">
                <controls:RepeatButtonWithIndicator.ButtonContent>
                    <StackPanel>
                        <Label HorizontalAlignment="Center" Content="Гидравлика 2"/>
                        <Label HorizontalAlignment="Center" Content="Включить"/>
                    </StackPanel>
                </controls:RepeatButtonWithIndicator.ButtonContent>
            </controls:RepeatButtonWithIndicator>
            <Button
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,5,0,5"
                Content="Поддержка вверх"/>
            <Button
                Grid.Row="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,5,0,5">
                <StackPanel>
                    <Label HorizontalAlignment="Center" Content="Смазку дорна"/>
                    <Label HorizontalAlignment="Center" Content="Включить"/>
                </StackPanel>
            </Button>
            <Button
                Grid.Row="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,5,0,5">
                <StackPanel>
                    <Label HorizontalAlignment="Center" Content="Гиб вперёд"/>
                    <Label HorizontalAlignment="Center" Content="Дожим вперёд"/>
                </StackPanel>
            </Button>
            <!--TODO: Добавить кнопки лифта, у которых Grid.RowSpan="2"-->
        </Grid>
        <Separator
            Grid.Column="1"
            Margin="5,0,5,0"
            VerticalAlignment="Stretch"/>
        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <controls:RepeatButtonWithIndicator
                Grid.Column="0"
                Grid.Row="0"
                ButtonContent="Зажим назад"
                Interval="100"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="0"
                Grid.Row="1"
                ButtonContent="Прижим назад"
                Interval="100"/>
            <Grid
                Grid.Column="0"
                Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <RepeatButton
                    x:Name="PressureBackButton"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="Дожим 1 назад"
                    Interval="100"
                    PreviewMouseDown="PressureBackButton_PreviewMouseDown"
                    PreviewMouseUp="PressureBackButton_PreviewMouseUp"/>
                <Border Grid.Column="1" Grid.Row="0" Margin="5" CornerRadius="5">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="PressureBackIndicatorFirst" Color="DarkRed"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Margin="5" CornerRadius="5">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="PressureBackIndicatorSecond" Color="DarkRed"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
            </Grid>
            <controls:RepeatButtonWithIndicator
                Grid.Column="0"
                Grid.Row="3"
                ButtonContent="Гиб назад"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="0"
                Grid.Row="4"
                ButtonContent="Цанга разжим"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="0"
                Grid.Row="5"
                ButtonContent="Дорн назад"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="0"
                Grid.Row="6"
                ButtonContent="Оснастка вниз"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="0"
                Grid.Row="7"
                ButtonContent="Пробивка назад"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="1"
                Grid.Row="0"
                ButtonContent="Зажим вперёд"
                Interval="100"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="1"
                Grid.Row="1"
                ButtonContent="Прижим вперёд"
                Interval="100"/>
            <Grid
                Grid.Column="1"
                Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <RepeatButton
                    x:Name="PressureForwardButton"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="Дожим 1 назад"
                    Interval="100"
                    PreviewMouseDown="PressureForwardButton_PreviewMouseDown"
                    PreviewMouseUp="PressureForwardButton_PreviewMouseUp"/>
                <Border Grid.Column="1" Grid.Row="0" Margin="5" CornerRadius="5">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="PressureForwardIndicatorFirst" Color="DarkRed"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Margin="5" CornerRadius="5">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="PressureForwardIndicatorSecond" Color="DarkRed"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
            </Grid>
            <controls:RepeatButtonWithIndicator
                Grid.Column="1"
                Grid.Row="3"
                ButtonContent="Гиб вперёд"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="1"
                Grid.Row="4"
                ButtonContent="Цанга зажим"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="1"
                Grid.Row="5"
                ButtonContent="Дорн вперёд"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="1"
                Grid.Row="6"
                ButtonContent="Оснастка вверх"/>
            <controls:RepeatButtonWithIndicator
                Grid.Column="1"
                Grid.Row="7"
                ButtonContent="Пробивка вперёд"/>
        </Grid>
        <StackPanel
            Grid.Column="2"
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,5,0,5"
            HorizontalAlignment="Center">
            <TextBlock Margin="5,5,5,0" Text="Угол гиба, градусы"/>
            <TextBox Margin="5,0,5,0" Text="0.0" IsReadOnly="True"/>
            <Button Margin="5,0,5,0" Content="Обнуление"/>
        </StackPanel>
        
        <Separator
            Grid.Column="3"
            Margin="5,0,5,0"
            VerticalAlignment="Stretch"/>

        <Grid Grid.Column="4" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <controls:SpeedControl
                Grid.Row="0"
                ControlName="Подача"/>
            <Separator
                Grid.Row="1"
                Margin="0,5,0,5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"/>
            <controls:SpeedControl
                Grid.Row="2"
                ControlName="Поворот"/>
            <Separator
                Grid.Row="3"
                Margin="0,5,0,5"
                HorizontalAlignment="Stretch"/>
            <controls:SpeedControl
                Grid.Row="4"
                ControlName="Консоль"/>
        </Grid>
        <StackPanel
            Grid.Column="4"
            Grid.Row="1"
            Margin="0,5,0,5"
            HorizontalAlignment="Center">
            <Button Content="Сброс ошибок сервопривода"/>
        </StackPanel>
    </Grid>
</Page>
