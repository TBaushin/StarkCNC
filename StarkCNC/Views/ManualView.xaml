<Page x:Class="StarkCNC.Views.ManualView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:local="clr-namespace:StarkCNC.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance vm:ManualViewModel}"
      Title="{x:Static lang:Language.ManualPageTitle}">
    <Page.Resources>
        <Style TargetType="controls:ButtonWithIndicator">
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid
            Grid.Column="0"
            Grid.Row="0"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button
                Grid.Row="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,5,0,5"
                Content="Ручной режим"/>
            <controls:ButtonWithIndicator
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Margin="0,5,0,5"
                Command="{Binding HydraulicsFirstTurnOnCommand}"
                CommandCancel="{Binding HydraulicsFirstTurnOffCommand}">
                <controls:ButtonWithIndicator.ButtonContent>
                    <StackPanel>
                        <Label HorizontalAlignment="Center" Content="Гидравлика 1"/>
                        <Label HorizontalAlignment="Center" Content="Включить"/>
                    </StackPanel>
                </controls:ButtonWithIndicator.ButtonContent>
            </controls:ButtonWithIndicator>
            <controls:ButtonWithIndicator
                Grid.Row="2"
                HorizontalAlignment="Stretch"
                Margin="0,5,0,5"
                Command="{Binding HydraulicsSecondTurnOnCommand}"
                CommandCancel="{Binding HydraulicsSecondTurnOffCommand}">
                <controls:ButtonWithIndicator.ButtonContent>
                    <StackPanel>
                        <Label HorizontalAlignment="Center" Content="Гидравлика 2"/>
                        <Label HorizontalAlignment="Center" Content="Включить"/>
                    </StackPanel>
                </controls:ButtonWithIndicator.ButtonContent>
            </controls:ButtonWithIndicator>
            <Button
                x:Name="SupportButton"
                Grid.Row="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,5,0,5"
                Content="Поддержка вверх"
                MouseDown="SupportButton_MouseDown"
                MouseUp="SupportButton_MouseUp"/>
            <Button
                x:Name="DornLubricantButton"
                Grid.Row="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,5,0,5"
                MouseDown="DornLubricantButton_MouseDown"
                MouseUp="DornLubricantButton_MouseUp">
                <StackPanel>
                    <Label HorizontalAlignment="Center" Content="Смазку дорна"/>
                    <Label HorizontalAlignment="Center" Content="Включить"/>
                </StackPanel>
            </Button>
            <Button
                x:Name="BendAndSqueezeButton"
                Grid.Row="5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0,5,0,5"
                MouseDown="BendAndSqueezeButton_MouseDown"
                MouseUp="BendAndSqueezeButton_MouseUp">
                <StackPanel>
                    <Label HorizontalAlignment="Center" Content="Гиб вперёд"/>
                    <Label HorizontalAlignment="Center" Content="Дожим вперёд"/>
                </StackPanel>
            </Button>
            <!--TODO: Добавить кнопки лифта, у которых Grid.RowSpan="2"-->
        </Grid>
        <Separator
            Grid.Column="1"
            Margin="5,0,5,0"
            VerticalAlignment="Stretch"/>
        <Grid Grid.Column="2" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <controls:ButtonWithIndicator
                Grid.Column="0"
                Grid.Row="0"
                ButtonContent="Зажим назад"
                Command="{Binding ClampBackwardStartCommand}"
                CommandCancel="{Binding ClampBackwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="0"
                Grid.Row="1"
                ButtonContent="Прижим назад"
                Command="{Binding PressBackwardStartCommand}"
                CommandCancel="{Binding PressBackwardStopCommand}"/>
            <Grid
                Grid.Column="0"
                Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Button
                    x:Name="PressureBackButton"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="Дожим 1 назад"
                    PreviewMouseDown="PressureBackButton_PreviewMouseDown"
                    PreviewMouseUp="PressureBackButton_PreviewMouseUp"/>
                <Border Grid.Column="1" Grid.Row="0" Margin="5" CornerRadius="5">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="PressureBackIndicatorFirst" Color="DarkRed"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Margin="5" CornerRadius="5">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush x:Name="PressureBackIndicatorSecond" Color="DarkRed"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
            </Grid>
            <controls:ButtonWithIndicator
                Grid.Column="0"
                Grid.Row="3"
                ButtonContent="Гиб назад"
                Command="{Binding BendBackwardStartCommand}"
                CommandCancel="{Binding BendBackwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="0"
                Grid.Row="4"
                ButtonContent="Цанга разжим"
                Command="{Binding ColletBackwardStartCommand}"
                CommandCancel="{Binding ColletBackwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="0"
                Grid.Row="5"
                ButtonContent="Дорн назад"
                Command="{Binding DornBackwardStartCommand}"
                CommandCancel="{Binding DornBackwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="0"
                Grid.Row="6"
                ButtonContent="Оснастка вниз"
                Command="{Binding AdjustmentBackwardStartCommand}"
                CommandCancel="{Binding AdjustmentBackwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="0"
                Grid.Row="7"
                ButtonContent="Пробивка назад"
                Command="{Binding PunchingBackwardStartCommand}"
                CommandCancel="{Binding PunchingBackwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="1"
                Grid.Row="0"
                ButtonContent="Зажим вперёд"
                Command="{Binding ClampForwardStartCommand}"
                CommandCancel="{Binding ClampForwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="1"
                Grid.Row="1"
                ButtonContent="Прижим вперёд"
                Command="{Binding PressForwardStartCommand}"
                CommandCancel="{Binding PressForwardStopCommand}"/>
            <Grid
                Grid.Column="1"
                Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Button
                    x:Name="PressureForwardButton"
                    Grid.Column="0"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Content="Дожим 1 вперёд"
                    PreviewMouseDown="PressureForwardButton_PreviewMouseDown"
                    PreviewMouseUp="PressureForwardButton_PreviewMouseUp"/>
                <Border Grid.Column="1" Grid.Row="0" Margin="5" CornerRadius="5">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush
                                x:Name="PressureForwardIndicatorFirst"
                                Color="DarkRed"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Margin="5" CornerRadius="5">
                    <Rectangle>
                        <Rectangle.Fill>
                            <SolidColorBrush
                                x:Name="PressureForwardIndicatorSecond"
                                Color="DarkRed"/>
                        </Rectangle.Fill>
                    </Rectangle>
                </Border>
            </Grid>
            <controls:ButtonWithIndicator
                Grid.Column="1"
                Grid.Row="3"
                ButtonContent="Гиб вперёд"
                Command="{Binding BendForwardStartCommand}"
                CommandCancel="{Binding BendForwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="1"
                Grid.Row="4"
                ButtonContent="Цанга зажим"
                Command="{Binding ColletForwardStartCommand}"
                CommandCancel="{Binding ColletForwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="1"
                Grid.Row="5"
                ButtonContent="Дорн вперёд"
                Command="{Binding DornForwardStartCommand}"
                CommandCancel="{Binding DornForwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="1"
                Grid.Row="6"
                ButtonContent="Оснастка вверх"
                Command="{Binding AdjustmentForwardStartCommand}"
                CommandCancel="{Binding AdjustmentForwardStopCommand}"/>
            <controls:ButtonWithIndicator
                Grid.Column="1"
                Grid.Row="7"
                ButtonContent="Пробивка вперёд"
                Command="{Binding PunchingForwardStartCommand}"
                CommandCancel="{Binding PunchingForwardStopCommand}"/>
        </Grid>
        <StackPanel
            Grid.Column="2"
            Grid.Row="1"
            Orientation="Horizontal"
            Margin="0,5,0,5"
            HorizontalAlignment="Center">
            <Label
                Margin="5,5,5,0"
                Content="Угол гиба, градусы"/>
            <TextBox Margin="5,0,5,0" Text="0.0" IsReadOnly="True"/>
            <Button Margin="5,0,5,0" Content="Обнуление"/>
        </StackPanel>
        
        <Separator
            Grid.Column="3"
            Margin="5,0,5,0"
            VerticalAlignment="Stretch"/>

        <Grid Grid.Column="4" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <controls:SpeedControl
                Grid.Row="0"
                ControlName="Подача"
                ForwardCommand="{Binding FeedForwardStartCommand}"
                ForwardCancelCommand="{Binding FeedForwardStopCommand}"
                BackwardCommand="{Binding FeedBackwardStartCommand}"
                BackwardCancelCommand="{Binding FeedBackwardStopCommand}"/>
            <Separator
                Grid.Row="1"
                Margin="0,5,0,5"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"/>
            <controls:SpeedControl
                Grid.Row="2"
                ControlName="Поворот"
                ForwardCommand="{Binding TurnForwardStartCommand}"
                ForwardCancelCommand="{Binding TurnForwardStopCommand}"
                BackwardCommand="{Binding TurnBackwardStartCommand}"
                BackwardCancelCommand="{Binding TurnBackwardStopCommand}"/>
            <Separator
                Grid.Row="3"
                Margin="0,5,0,5"
                HorizontalAlignment="Stretch"/>
            <controls:SpeedControl
                Grid.Row="4"
                ControlName="Консоль"
                ForwardCommand="{Binding ConsoleForwardStartCommand}"
                ForwardCancelCommand="{Binding ConsoleForwardStopCommand}"
                BackwardCommand="{Binding ConsoleBackwardStartCommand}"
                BackwardCancelCommand="{Binding ConsoleBackwardStopCommand}"/>
        </Grid>
        <StackPanel
            Grid.Column="4"
            Grid.Row="1"
            Margin="0,5,0,5"
            HorizontalAlignment="Center">
            <Button Content="Сброс ошибок сервопривода"/>
        </StackPanel>
    </Grid>
</Page>
