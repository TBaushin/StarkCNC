<Page x:Class="StarkCNC.Views.AdjustmentView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:local="clr-namespace:StarkCNC.Views"
      d:DataContext="{d:DesignInstance vm:AdjustmentViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static lang:Language.AdjustmentPageTitle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="37"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Orientation="Horizontal">
            <Label
                Content="Выбор оснастки"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/> <!--TODO: Перевести-->
        </StackPanel>
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Orientation="Horizontal">
            <Button
                HorizontalAlignment="Right"
                Command="{Binding GoToAdjustmentListCommand}">
                <TextBlock
                    Margin="0,4,0,4"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="15"
                    Text="&#xE90F;"/>
            </Button>
        </StackPanel>
        <Separator Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,5,0,5"/>
        <StackPanel
            Grid.Row="2"
            Orientation="Vertical">
            <controls:FloorControl
                FloorText="Этаж 3"/> <!--TODO: Сделать генерируемым и перевести-->
            <controls:FloorControl
                FloorText="Этаж 2"/> <!--TODO: Сделать генерируемым и перевести-->
            <controls:FloorControl
                FloorText="Этаж 1"/> <!--TODO: Сделать генерируемым и перевести-->
        </StackPanel>
    </Grid>
</Page>
