<Page x:Class="StarkCNC.Views.AdjustmentView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:local="clr-namespace:StarkCNC.Views"
      d:DataContext="{d:DesignInstance vm:AdjustmentViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static lang:Language.AdjustmentPageTitle}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="37"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Orientation="Horizontal">
            <Label
                Content="Выбор оснастки"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"/> <!--TODO: Перевести-->
        </StackPanel>
        <StackPanel
            Grid.Row="0"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Orientation="Horizontal">
            <Button
                HorizontalAlignment="Right"
                Command="{Binding GoToAdjustmentListCommand}">
                <TextBlock
                    Margin="0,4,0,4"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="15"
                    Text="&#xE90F;"/>
            </Button>
        </StackPanel>
        <Separator Grid.Row="1" HorizontalAlignment="Stretch" Margin="0,5,0,5"/>
        <StackPanel
            Grid.Row="2"
            Orientation="Vertical">
            <Border
                Margin="8,4,8,4"
                MinHeight="80"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <controls:FloorControl
                    Margin="10,0,10,0"
                    FloorText="Этаж 3"/> <!--TODO: Сделать генерируемым и перевести-->
            </Border>
            <Border
                Margin="8,4,8,4"
                MinHeight="80"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <controls:FloorControl
                    Margin="10,0,10,0"
                    FloorText="Этаж 2"/> <!--TODO: Сделать генерируемым и перевести-->
            </Border>
            <Border
                Margin="8,4,8,4"
                MinHeight="80"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <controls:FloorControl
                    Margin="10,0,10,0"
                    FloorText="Этаж 1"/> <!--TODO: Сделать генерируемым и перевести-->
            </Border>
            <Expander Margin="8,4,7,4">
                <ListView>
                    <ListViewItem>
                        <ListViewItem.Template>
                            <ControlTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Grid.Row="0"
                                        Grid.ColumnSpan="2"/>
                                    <StackPanel
                                        Grid.Column="0"
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                        <Button/>
                                        <Button/>
                                        <Button/>
                                    </StackPanel>
                                    <StackPanel
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                        <Button/>
                                        <Button/>
                                    </StackPanel>
                                </Grid>
                            </ControlTemplate>
                        </ListViewItem.Template>
                    </ListViewItem>
                </ListView>
            </Expander>
            <Border
                Margin="8,4,8,4"
                MinHeight="80"
                CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                MouseEnter="Border_MouseEnter"
                MouseLeave="Border_MouseLeave"
                MouseDown="Border_MouseDown">
                <Grid Margin="10,0,10,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Grid.Column="0"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="4,0,4,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE950;"/>
                        <TextBlock Text="Управление оснастками"/>
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="4,0,4,0"
                        FontSize="20"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Text="&#xE76C;"/>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Page>
