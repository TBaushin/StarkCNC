<Page x:Class="StarkCNC.Views.AutomaticView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:utilities="clr-namespace:StarkCNC.Utilities;assembly=StarkCNC.Utilities"
      xmlns:local="clr-namespace:StarkCNC.Views"
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      d:DataContext="{d:DesignInstance vm:AutomaticViewModel}"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Автомат">
    <Page.Resources>
        <utilities:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <Style TargetType="controls:LabelWithIndicatorControl">
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Page.Resources>

    <Grid ColumnDefinitions="4*,3*" RowDefinitions="18*,*,*">
        <StackPanel
            Grid.Column="0"
            Grid.Row="0">
            <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
                <!--Row 0-->
                <Border
                    Grid.Column="0"
                    Grid.Row="0"
                    Margin="0,10,10,10"
                    MinHeight="30"
                    CornerRadius="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Label
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Content="{Binding ProgramName}"/>
                </Border>
                <Grid
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="25,10,0,10"
                    ColumnDefinitions="*,*">
                    <Label
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Content="Время цикла:"/>
                    <controls:LabeledTextBoxControl
                        Grid.Column="1"
                        IsEnabled="False"
                        Text="{Binding CycleTime, StringFormat={}{0} сек., Mode=TwoWay}"
                        Validation.ErrorTemplate="{x:Null}"/>
                </Grid>

                <!--Row 1-->
                <Grid
                    Grid.Column="0"
                    Grid.Row="1"
                    Margin="0,10,10,10"
                    ColumnDefinitions="*,*">
                    <Label
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Content="Точка установки: "/>
                    <controls:PrefixedTextBoxControl
                        Grid.Column="1"
                        NeedCallNumberInput="True"
                        IsNumericOnly="True"
                        Prefix="Y:"
                        Text="{Binding SetUpPoint, Mode=TwoWay}"/>
                </Grid>
                <Grid
                    Grid.Column="1"
                    Grid.Row="1"
                    Margin="25,10,0,10"
                    ColumnDefinitions="*,*">
                    <Label
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Content="Длина трубы: "/>
                    <controls:PrefixedTextBoxControl
                        Grid.Column="1"
                        NeedCallNumberInput="True"
                        IsNumericOnly="True"
                        Prefix="L:"
                        Text="{Binding PipeLength, Mode=TwoWay}"/>
                </Grid>
            </Grid>
            <DataGrid
                ItemsSource="{Binding BendingDatas}"
                AutoGenerateColumns="False"
                ColumnWidth="*"
                HorizontalAlignment="Stretch"
                VerticalGridLinesBrush="{x:Null}"
                HeadersVisibility="Column"
                CanUserReorderColumns="False"
                CanUserResizeColumns="False"
                CanUserSortColumns="False"
                CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="39">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Label Content="№"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Content="{Binding Id}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Label>
                                    <TextBlock>
                                        <Run Text="Подача"/>
                                        <Run
                                            FontFamily="pack://application:,,,/Resources/Fonts/#ADLaM Display"
                                            Text="Y"/>
                                    </TextBlock>
                                </Label>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Content="{Binding Supply}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Label>
                                    <TextBlock>
                                        <Run Text="Поворот"/>
                                        <Run
                                            FontFamily="pack://application:,,,/Resources/Fonts/#ADLaM Display"
                                            Text="B"/>
                                    </TextBlock>
                                </Label>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Content="{Binding RotationAngle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Label>
                                    <TextBlock>
                                        <Run Text="Гиб"/>
                                        <Run
                                            FontFamily="pack://application:,,,/Resources/Fonts/#ADLaM Display"
                                            Text="C"/>
                                    </TextBlock>
                                </Label>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Content="{Binding BendingAngle}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.HeaderTemplate>
                            <DataTemplate>
                                <Label>
                                    <TextBlock>
                                        <Run Text="Радиус"/>
                                        <Run
                                            FontFamily="pack://application:,,,/Resources/Fonts/#ADLaM Display"
                                            Text="R"/>
                                    </TextBlock>
                                </Label>
                            </DataTemplate>
                        </DataGridTemplateColumn.HeaderTemplate>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Label
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Content="{Binding BendingRadius}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <StackPanel
            Margin="20,10,0,0"
            Grid.Column="1"
            Grid.Row="0">
            <Grid ColumnDefinitions="*,*">
                <Label
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Content="Наименование заказа:"/>
                <Border
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    MinHeight="30"
                    CornerRadius="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Label
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Content="{Binding ProgramName}"/>
                </Border>
            </Grid>
            <Grid ColumnDefinitions="*,*">
                <Label
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Content="Оператор:"/>
                <Border
                    Grid.Column="1"
                    Margin="0,0,0,10"
                    MinHeight="30"
                    CornerRadius="4"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Label
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Content="{Binding Operator}"/>
                </Border>
            </Grid>
            <Grid ColumnDefinitions="*,*">
                <Label
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="Количество вып. деталей"/>
                <controls:LabeledTextBoxControl
                    x:Name="CountCompletedDetailsLabeledTextBox"
                    Grid.Column="1"
                    IsNumericOnly="True"
                    IsReadOnly="True"
                    PreviewMouseDown="CountCompletedDetailsLabeledTextBox_PreviewMouseDown"
                    PreviewMouseUp="CountCompletedDetailsLabeledTextBox_PreviewMouseUp"
                    IsEnabled="{Binding CanChangeCountDetails}"
                    Text="{Binding CountCompletedDetails, StringFormat={}{0} шт.}"
                    Validation.ErrorTemplate="{x:Null}"/>
            </Grid>
            <Grid ColumnDefinitions="*,*">
                <Label
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="Задание деталей"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    NeedCallNumberInput="True"
                    IsNumericOnly="True"
                    IsEnabled="{Binding CanChangeCountDetails}"
                    Text="{Binding TaskDetails, StringFormat={}{0} шт., Mode=TwoWay}"
                    Validation.ErrorTemplate="{x:Null}"/>
            </Grid>
            <Grid ColumnDefinitions="*, *" Margin="0,7,0,4">
                <Label
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="Полный автомат"/>
                <controls:ToggleSwitchControl
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    IsChecked="{Binding IsFullAtomatic, Mode=TwoWay}"/>
            </Grid>
            <Grid
                ColumnDefinitions="*,*"
                Visibility="{Binding IsFullAtomatic, Converter={StaticResource BoolToVisibilityConverter}}">
                <Label
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Content="Задержка установки трубы"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    NeedCallNumberInput="True"
                    IsNumericOnly="True"
                    Text="{Binding PipeInstallationDelay, StringFormat={}{0} сек., Mode=TwoWay}"
                    Validation.ErrorTemplate="{x:Null}"/>
            </Grid>
        </StackPanel>
        <Border
            Margin="18,0,0,0"
            Grid.Column="1"
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="{DynamicResource LayerOnMicaBaseAltFillColorTertiaryBrush}"
            BorderBrush="{DynamicResource LayerOnMicaBaseAltFillColorTertiaryBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Panel.ZIndex="1"
            Visibility="{Binding ShowInputOutputTable, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid ColumnDefinitions="*,*,41">
                <Button
                    Grid.Column="2"
                    Margin="0,5,5,0"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Center"
                    VerticalAlignment="Top"
                    Command="{Binding ShowOrHideInputOutputTableCommand}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        FontSize="14"
                        Text="&#xE711;"/>
                </Button>
                <Grid
                    Grid.Column="0"
                    Margin="5,5,5,0"
                    RowDefinitions="30,*">
                    <Border
                        Grid.Row="0"
                        Padding="4"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4,4,0,0">
                        <Label
                            HorizontalContentAlignment="Center"
                            Content="Входные сигналы"/>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,5"
                        VerticalAlignment="Stretch"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="0,0,4,4">
                        <StackPanel Margin="5,0,0,0">
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ClampForwardSensorStatus}"
                                Text="Зажим пер. датчик"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ClampBackwardSensorStatus}"
                                Text="Зажим зад. датчик"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding PressForwardSensorStatus}"
                                Text="Прижим пер. датчик"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding PressBackwardSensorStatus}"
                                Text="Прижим зад. датчик"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding SqueezeForwardSensorStatus}"
                                Text="Дожим пер. датчик"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding SqueezeBackwardSensorStatus}"
                                Text="Дожим зад. датчик"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                Visibility="{Binding Settings.MultiLeveled, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsActive="{Binding SecondSqueezeForwardSensorStatus}"
                                Text="Дожим 2 пер. датчик"/>
                            <controls:LabelWithIndicatorControl
                                Visibility="{Binding Settings.MultiLeveled, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsActive="{Binding SecondSqueezeBackwardSensorStatus}"
                                Text="Дожим 2 зад. датчик"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding DornForwardSensorStatus}"
                                Text="Дорн пер. датчик"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding DornBackwardSensorStatus}"
                                Text="Дорн зад. датчик"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding BendForwardSensorStatus}"
                                Text="Гиб пер. датчик"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding BendBackwardSensorStatus}"
                                Text="Гиб зад. датчик"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ColletForwardSensorStatus}"
                                Text="Цанга пер. датчик"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ColletBackwardSensorStatus}"
                                Text="Цанга зад. датчик"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ConsoleForwardSensorStatus}"
                                Text="Консоль пер. датчик"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ConsoleBackwardSensorStatus}"
                                Text="Консоль зад. датчик"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding SupplyBackwardSensorStatus}"
                                Text="Подача зад. датчик"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding SupplyResetSensorStatus}"
                                Text="Датчик обнул. подачи"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding RotationResetSensorStatus}"
                                Text="Датчик обнул. поворота"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding SupportLowerSensorStatus}"
                                Text="Поддержка внизу"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding AdjustmentUpperSensorStatus}"
                                Text="Оснастка верх. датчик"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding AdjustmentMiddleSensorStatus}"
                                Text="Оснастка сред. датчик"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding AdjustmentLowerSensorStatus}"
                                Text="Оснастка ниж. датчик"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding PunchingForwardSensorStatus}"
                                Text="Пробивка впереди"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding PunchingBackwardSensorStatus}"
                                Text="Пробивка сзади"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding PedalSensorStatus}"
                                Text="Педаль"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding StopButtonSensorStatus}"
                                Text="Кнопка &quot;Cтоп&quot;"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding StartButtonSensorStatus}"
                                Text="Кнопка &quot;Старт&quot;"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ElectricMotorsBreakerSensorStatus}"
                                Text="Авт. защиты эл.моторов"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding BackwardProtectionPanelSensorStatus}"
                                Text="Задняя защит. панель"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ForwardProtectionPanelSensorStatus}"
                                Text="Передняя защит. панель"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding SpeedTumblerLeftwardSensorStatus}"
                                Text="Тумблер скорости влево"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding SpeedTumblerRightwardSensorStatus}"
                                Text="Тумблер скорости вправо"/>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid
                    Grid.Column="1"
                    Margin="5,5,5,0"
                    RowDefinitions="30,*">
                    <Border
                        Grid.Row="0"
                        Padding="4"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="4,4,0,0">
                        <Label
                            HorizontalContentAlignment="Center"
                            Content="Выходные сигналы"/>
                    </Border>
                    <Border
                        Grid.Row="1"
                        Margin="0,0,0,5"
                        VerticalAlignment="Stretch"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="0,0,4,4">
                        <StackPanel>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ClampForwardOutputSignalStatus}"
                                Text="Зажим вперёд"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ClampForwardOutputSignalStatus}"
                                Text="Зажим назад"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding PressForwardOutputSignalStatus}"
                                Text="Прижим вперёд"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding PressForwardOutputSignalStatus}"
                                Text="Прижим назад"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding SqueezeForwardOutputSignalStatus}"
                                Text="Дожим вперёд"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding SqueezeForwardOutputSignalStatus}"
                                Text="Дожим назад"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                Visibility="{Binding Settings.MultiLeveled, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsActive="{Binding AdjustmentUpOutputSignalStatus}"
                                Text="Оснастка вверх"/>
                            <controls:LabelWithIndicatorControl
                                Visibility="{Binding Settings.MultiLeveled, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsActive="{Binding AdjustmentDownOutputSignalStatus}"
                                Text="Оснастка вниз"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                Visibility="{Binding Settings.WithPunchingCylinder, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsActive="{Binding PunchingForwardOutputSignalStatus}"
                                Text="Пробивка вперёд"/>
                            <controls:LabelWithIndicatorControl
                                Visibility="{Binding Settings.WithPunchingCylinder, Converter={StaticResource BoolToVisibilityConverter}}"
                                IsActive="{Binding PunchingForwardOutputSignalStatus}"
                                Text="Пробивка назад"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding FirstHydraulicsOutputSignalStatus}"
                                Text="Гидростанция 1"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding FirstValveOutputSignalStatus}"
                                Text="Клапан 1"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding DornForwardOutputSignalStatus}"
                                Text="Дорн вперёд"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding DornBackwardOutputSignalStatus}"
                                Text="Дорн назад"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                Visibility="{Binding Settings.IsElectricBendingDrive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='invert'}"
                                IsActive="{Binding BendForwardOutputSignalStatus}"
                                Text="Гиб вперёд"/>
                            <controls:LabelWithIndicatorControl
                                Visibility="{Binding Settings.IsElectricBendingDrive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='invert'}"
                                IsActive="{Binding BendForwardOutputSignalStatus}"
                                Text="Гиб назад"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ColletForwardOutputSignalStatus}"
                                Text="Цанга зажим"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ColletForwardOutputSignalStatus}"
                                Text="Цанга разжим"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                Visibility="{Binding Settings.IsElectricBendingDrive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='invert'}"
                                IsActive="{Binding SecondHydraulicsOutputSignalStatus}"
                                Text="Гидростанция 2"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                Visibility="{Binding Settings.IsElectricBendingDrive, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='invert'}"
                                IsActive="{Binding SecondValveOutputSignalStatus}"
                                Text="Клапан 2"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding FirstSupportUpOutputSignalStatus}"
                                Text="Поддержка 1 вверх"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding SecondSupportUpOutputSignalStatus}"
                                Text="Поддержка 2 вверх"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding ThirdSupportUpOutputSignalStatus}"
                                Text="Поддержка 3 вверх"/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding FourthSupportUpOutputSignalStatus}"
                                Text="Поддержка 4 вверх"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding RotationBrakingOutputSignalStatus}"
                                Text="Расторможение поворота"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding GuideLubricantOutputSignalStatus}"
                                Text="Смазка направляющих"/>
                            <Separator/>
                            <controls:LabelWithIndicatorControl
                                IsActive="{Binding DornLubricantOutputSignalStatus}"
                                Text="Смазка дорна"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
        <Grid
            Grid.Column="0"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            ColumnDefinitions="*,1.8*,1.8*,1.8*,1.8*,3*,3*">
            <!--ROW 0-->
            <Label
                Grid.Column="0"
                Grid.Row="0"
                VerticalAlignment="Center"
                Content="Задание:"/>
            <controls:PrefixedTextBoxControl
                Grid.Column="1"
                Grid.Row="0"
                Margin="10,0,10,0"
                IsNumericOnly="True"
                IsReadOnly="True"
                Prefix="Y:"
                Text="{Binding CurrentTaskSupply}"/>
            <controls:PrefixedTextBoxControl
                Grid.Column="2"
                Grid.Row="0"
                Margin="10,0,10,0"
                IsNumericOnly="True"
                IsReadOnly="True"
                Prefix="B:"
                Text="{Binding CurrentTaskRotationAngle}"/>
            <controls:PrefixedTextBoxControl
                Grid.Column="3"
                Grid.Row="0"
                Margin="10,0,10,0"
                IsNumericOnly="True"
                IsReadOnly="True"
                Prefix="C:"
                Text="{Binding CurrentTaskBendingAngle}"/>
        </Grid>
        <Grid
            Grid.Column="0"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            ColumnDefinitions="*,1.8*,1.8*,1.8*,1.8*,3*,3*">
            <!--ROW 1-->
            <Label
                Grid.Column="0"
                Grid.Row="1"
                VerticalAlignment="Center"
                Content="Координаты:"/>
            <controls:PrefixedTextBoxControl
                Grid.Column="1"
                Grid.Row="1"
                Margin="10,0,10,0"
                IsNumericOnly="True"
                IsReadOnly="True"
                Prefix="Y:"
                Text="{Binding FacticalSupply}"/>
            <controls:PrefixedTextBoxControl
                Grid.Column="2"
                Grid.Row="1"
                Margin="10,0,10,0"
                IsNumericOnly="True"
                IsReadOnly="True"
                Prefix="B:"
                Text="{Binding FacticalRotationAngle}"/>
            <controls:PrefixedTextBoxControl
                Grid.Column="3"
                Grid.Row="1"
                Margin="10,0,10,0"
                IsNumericOnly="True"
                IsReadOnly="True"
                Prefix="C:"
                Text="{Binding FacticalBendingAngle}"/>
            <controls:PrefixedTextBoxControl
                Grid.Column="4"
                Grid.Row="1"
                Margin="10,0,10,0"
                IsNumericOnly="True"
                IsReadOnly="True"
                Prefix="X:"
                Text="{Binding FactialConsole}"/>
            <Button
                Grid.Column="5"
                Grid.Row="1"
                Margin="10,0,10,0"
                Content="Таблица входов-выходов"
                Command="{Binding ShowOrHideInputOutputTableCommand}"/>
            <Button
                Grid.Column="6"
                Grid.Row="1"
                Margin="10,0,10,0"
                HorizontalAlignment="Right"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}"
                Content="Сброс ошибок приводов"
                Command="{Binding ClearActuatorErrorsCommand}"/>
        </Grid>
    </Grid>
</Page>
