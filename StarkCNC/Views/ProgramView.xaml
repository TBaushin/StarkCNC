<Page x:Class="StarkCNC.Views.ProgramView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:helix="http://helix-toolkit.org/wpf"
      xmlns:local="clr-namespace:StarkCNC.Views"
      d:DataContext="{d:DesignInstance vm:ProgramViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static lang:Language.ProgramPageTitle}">

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <StackPanel 
                Orientation="Horizontal"
                HorizontalAlignment="Stretch"
                Margin="10">
                <Button 
                    x:Name="CreateButton" 
                    Command="{Binding CreateNewFileCommand}"
                    Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="10"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE710;"/>
                        <TextBlock 
                            Margin="8,0,0,0" 
                            Text="{x:Static lang:Language.CreateButton}"/>
                    </StackPanel>
                </Button>
                <Button 
                    x:Name="OpenButton" 
                    Command="{Binding OpenFileCommand}"
                    Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock 
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE8E5;"/>
                        <TextBlock 
                            Margin="8,0,0,0"
                            Text="{x:Static lang:Language.OpenButton}"/>
                    </StackPanel>
                </Button>
                <Button 
                    x:Name="SaveButton" 
                    Command="{Binding SaveFileCommand}"
                    Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock 
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE74E;"/>
                        <TextBlock 
                            Margin="8,0,0,0"
                            Text="{x:Static lang:Language.SaveButton}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid
                HorizontalAlignment="Stretch"
                Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <controls:LabeledTextBoxControl
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    LabelText="Длина трубы"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    LabelText="Установка Y"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="2"
                    Margin="10,0,10,0"
                    LabelText="Расчётный остаток"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="№"/>
                <Separator
                    Grid.Column="1"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="4,0,4,0"
                    VerticalAlignment="Stretch"/>
                <StackPanel
                    Grid.Column="2"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                    <Label
                        HorizontalContentAlignment="Center"
                        Content="Подача Y"/>
                    <Button
                        HorizontalAlignment="Stretch"
                        Content="Speed"/>
                </StackPanel>
                <Separator
                    Grid.Column="3"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <StackPanel
                    Grid.Column="4"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                    <Label
                        HorizontalContentAlignment="Center"
                        Content="Поворот B"/>
                    <Button
                        HorizontalAlignment="Stretch"
                        Content="Speed"/>
                </StackPanel>
                <Separator
                    Grid.Column="5"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <Label
                    Grid.Column="6"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    HorizontalContentAlignment="Center"
                    Content="Гиб C"/>
                <Button
                    Grid.Column="6"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Stretch"
                    Content="Speed"/>
                <Button
                    Grid.Column="7"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Stretch"
                    Content="Коэффициент"/>
                <Separator
                    Grid.Column="8"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <StackPanel
                    Grid.Column="9"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                    <Label
                        HorizontalContentAlignment="Center"
                        Content="Радиус R"/>
                    <Button
                        HorizontalAlignment="Stretch"
                        Content="Режим"/>
                </StackPanel>
                <Separator
                    Grid.Column="10"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <Label
                    Grid.Column="11"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    HorizontalContentAlignment="Center"
                    Content="Отвод Y"/>
                <Button
                    Grid.Column="11"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Stretch"
                    Content="B"/>
                <Button
                    Grid.Column="12"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Stretch"
                    Content="Y2"/>
            </Grid>
            <ScrollViewer Margin="0,10,0,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding BendingDatas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Margin="0,3,0,3"
                                    Orientation="Vertical">
                                    <Separator
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Stretch"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="4*"/>
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Column="0"
                                            VerticalAlignment="Center"
                                            Content="{Binding Id}"/>
                                        <Separator
                                            Grid.Column="1"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Stretch"/>
                                        <Grid
                                            Grid.Column="2"
                                            Margin="0,2,0,2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Row="0"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text="{Binding StraightLength}"/>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Row="1"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text=""/>
                                        </Grid>
                                        <Separator
                                            Grid.Column="3"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Stretch"/>
                                        <StackPanel
                                            Grid.Column="4"
                                            Margin="0,2,0,2"
                                            Orientation="Vertical">
                                            <controls:PrefixedTextBoxControl
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text="{Binding RotationAngle}"/>
                                            <controls:PrefixedTextBoxControl
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text=""/>
                                        </StackPanel>
                                        <Separator
                                            Grid.Column="5"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Stretch"/>
                                        <Grid Grid.Column="6"
                                              Grid.ColumnSpan="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Grid.Row="0"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text="{Binding BendingAngle}"/>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Column="0"
                                                Grid.Row="1"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text=""/>
                                            <Separator
                                                Grid.Column="1"
                                                Grid.Row="1"
                                                Margin="3,0,3,0"
                                                VerticalAlignment="Stretch"/>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Column="2"
                                                Grid.Row="1"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text=""/>
                                        </Grid>
                                        <Separator
                                            Grid.Column="8"
                                            Margin="3,0,3,0"
                                            VerticalAlignment="Stretch"/>
                                        <StackPanel
                                            Grid.Column="9"
                                            Orientation="Vertical"
                                            Margin="0,2,0,2">
                                            <controls:PrefixedTextBoxControl
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text="{Binding BendingRadius}"/>
                                            <ComboBox
                                                Margin="0,5,0,5"
                                                ItemsSource="{Binding DataContext.BendModeList, RelativeSource={RelativeSource AncestorType=Page}}"/>
                                        </StackPanel>
                                        <Separator
                                            Grid.Column="10"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Stretch"/>
                                        <Grid Grid.Column="11"
                                              Grid.ColumnSpan="2"
                                              Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Grid.Row="0"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text=""/>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Column="0"
                                                Grid.Row="1"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text=""/>
                                            <Separator
                                                Grid.Column="1"
                                                Grid.Row="1"
                                                Margin="3,0,3,0"
                                                VerticalAlignment="Stretch"/>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Column="2"
                                                Grid.Row="1"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                Text=""/>
                                        </Grid>
                                    </Grid>
                                    <Separator
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Stretch"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button
                        x:Name="AddLineButton"
                        Click="AddLineButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Label
                                VerticalAlignment="Center"
                                FontSize="10"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Content=""/>
                            <Label
                                Margin="8,0,0,0"
                                Content="{x:Static lang:Language.AddButton}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </StackPanel>
        <Border 
            Grid.Column="1" 
            Margin="10"
            Padding="5,5,5,5"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <helix:HelixViewport3D 
                    x:Name="BendingView"
                    Grid.Column="0"
                    ViewCubeHeight="200"
                    ViewCubeWidth="200"
                    ViewCubeVerticalPosition="Bottom"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    RenderOptions.EdgeMode="Unspecified"
                    IsManipulationEnabled="True"
                    IsViewCubeEdgeClicksEnabled="True">
                    <helix:HelixViewport3D.Camera>
                        <PerspectiveCamera
                            Position="-1571,4801,3774"
                            LookDirection="2038,-5200,-2930"
                            UpDirection="-0.145,0.372,0.917"/>
                    </helix:HelixViewport3D.Camera>
                    <helix:HelixViewport3D.Background>
                        <LinearGradientBrush 
                            StartPoint="0.5,0"
                            EndPoint="0.5,1">
                            <GradientStop Color="#FF060A13" Offset="0"/>
                            <GradientStop Color="#FF1D64FF" Offset="1"/>
                        </LinearGradientBrush>
                    </helix:HelixViewport3D.Background>
                    <helix:DefaultLights/>
                </helix:HelixViewport3D>
                <StackPanel
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="10,0,10,0"
                    Orientation="Vertical">
                    <Button
                        x:Name="ZoomIn"
                        Margin="0,0,0,10"
                        Click="ZoomIn_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE8A3;"/>
                    </Button>
                    <Button
                        x:Name="ZoomOut"
                        Margin="0,0,0,10"
                        Click="ZoomOut_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE71F;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
