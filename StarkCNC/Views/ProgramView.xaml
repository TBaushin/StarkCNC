            <DataGrid
                x:Name="PipeBendParametersDataGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="True"
                CanUserSortColumns="False"
                ColumnWidth="*"
                ItemsSource="{Binding BendingDatas, Mode=TwoWay}"
                BeginningEdit="PipeBendParametersDataGrid_BeginningEdit"
                CanUserReorderColumns="False"
                CanUserResizeColumns="True"
                GridLinesVisibility="All"
                HeadersVisibility="None"
                RowHeaderWidth="0"
                HorizontalScrollBarVisibility="Auto"
                VerticalScrollBarVisibility="Auto"
                FontSize="11"
                SelectionMode="Single"
                SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="2*"
                        Binding="{Binding Number}"
                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style
                                TargetType="TextBlock"
                                BasedOn="{StaticResource EditableTextStyle}"/>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- Ось Y - РЕДАКТИРУЕМАЯ с разделенными числами -->
                    <DataGridTemplateColumn Width="4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{Binding StraightLength}"
                                        Style="{StaticResource EditableTextStyle}"/>

                                    <Rectangle
                                        Grid.Row="1"
                                        Fill="Black"
                                        Height="2"/>

                                    <!-- Нижняя часть с двумя числами, разделенными вертикальной чертой -->
                                    <Grid
                                        Grid.Row="2"
                                        Background="Gray">
                                        <TextBlock
                                            Text="{Binding StraightLength, StringFormat='Speed: {0}'}"
                                            Style="{StaticResource EditableTextStyle}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{Binding StraightLength}"
                                        Style="{StaticResource EditableTextStyle}"/>

                                    <Rectangle
                                        Grid.Row="1"
                                        Fill="Black"
                                        Height="2"/>

                                    <!-- Нижняя часть с двумя числами, разделенными вертикальной чертой -->
                                    <Grid Grid.Row="2">
                                        <TextBlock
                                            Text="{Binding StraightLength}"
                                            Style="{StaticResource EditableTextStyle}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{Binding StraightLength}"
                                        Style="{StaticResource EditableTextStyle}"/>

                                    <Rectangle
                                        Grid.Row="1"
                                        Fill="Black"
                                        Height="2"/>

                                    <!-- Нижняя часть с двумя числами, разделенными вертикальной чертой -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding StraightLength}"
                                            Style="{StaticResource EditableTextStyle}"/>
                                        <Rectangle
                                            Grid.Column="1"
                                            Fill="Black"
                                            Width="1"
                                            VerticalAlignment="Stretch"
                                            HorizontalAlignment="Center"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding StraightLength}"
                                            Style="{StaticResource EditableTextStyle}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- выбор режима гибки, радиус-->
                    <DataGridTemplateColumn Width="4*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{Binding StraightLength}" 
                                        Style="{StaticResource EditableTextStyle}"/>

                                    <Rectangle
                                        Grid.Row="1"
                                        Fill="Black"
                                        Height="2"/>
                                    <Grid Grid.Row="2">
                                        <ComboBox
                                            SelectedItem="{Binding BendMode, Mode=TwoWay}"
                                            ItemsSource="{Binding BendModeList}"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            HorizontalContentAlignment="Right"
                                            IsEditable="False"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="2*"/>
                                        <RowDefinition Height="1*"/>
                                        <RowDefinition Height="1*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Text="{Binding StraightLength}"
                                        Style="{StaticResource EditableTextStyle}"/>

                                    <Rectangle
                                        Grid.Row="1"
                                        Fill="Black"
                                        Height="2"/>

                                    <!-- Нижняя часть с двумя числами, разделенными вертикальной чертой -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="2"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding StraightLength}"
                                            Style="{StaticResource EditableTextStyle}"/>
                                        <Rectangle
                                            Grid.Column="1"
                                            Fill="Black"
                                            Width="1"
                                            VerticalAlignment="Stretch" HorizontalAlignment="Center"/>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding StraightLength}"
                                            Style="{StaticResource EditableTextStyle}"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>
                    <!--<DataGridTextColumn
                        Header="{x:Static lang:Language.StraightLength}"
                        Binding="{Binding StraightLength}"/>
                    <DataGridTextColumn
                        Header="{x:Static lang:Language.BendingAngle}"
                        Binding="{Binding BendingAngle}"/>
                    <DataGridTextColumn
                        Header="{x:Static lang:Language.BendingRadius}"
                        Binding="{Binding BendingRadius}"/>
                    <DataGridTextColumn
                        Header="{x:Static lang:Language.RotationAngle}"
                        Binding="{Binding RotationAngle}"/> -->
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
        <Border 
            Grid.Column="1" 
            Margin="10"
            Padding="5,5,5,5"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <helix:HelixViewport3D 
                    x:Name="BendingView"
                    Grid.Column="0"
                    ViewCubeHeight="200"
                    ViewCubeWidth="200"
                    ViewCubeVerticalPosition="Bottom"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    RenderOptions.EdgeMode="Unspecified"
                    IsManipulationEnabled="True"
                    IsViewCubeEdgeClicksEnabled="True">
                    <helix:HelixViewport3D.Camera>
                        <PerspectiveCamera
                            Position="-1571,4801,3774"
                            LookDirection="2038,-5200,-2930"
                            UpDirection="-0.145,0.372,0.917"/>
                    </helix:HelixViewport3D.Camera>
                    <helix:HelixViewport3D.Background>
                        <LinearGradientBrush 
                            StartPoint="0.5,0"
                            EndPoint="0.5,1">
                            <GradientStop Color="#FF060A13" Offset="0"/>
                            <GradientStop Color="#FF1D64FF" Offset="1"/>
                        </LinearGradientBrush>
                    </helix:HelixViewport3D.Background>
                    <helix:DefaultLights/>
                </helix:HelixViewport3D>
                <StackPanel
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="10,0,10,0"
                    Orientation="Vertical">
                    <Button
                        x:Name="ZoomIn"
                        Margin="0,0,0,10"
                        Click="ZoomIn_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE8A3;"/>
                    </Button>
                    <Button
                        x:Name="ZoomOut"
                        Margin="0,0,0,10"
                        Click="ZoomOut_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE71F;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
