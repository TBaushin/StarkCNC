<Page x:Class="StarkCNC.Views.ProgramView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:helix="http://helix-toolkit.org/wpf"
      xmlns:local="clr-namespace:StarkCNC.Views"
      d:DataContext="{d:DesignInstance vm:ProgramViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static lang:Language.ProgramPageTitle}">

    <Page.Resources>
        <!-- Стиль для выделенных ячеек (желтый фон) -->
        <Style x:Key="HighlightedCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Yellow"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Стиль для обычных ячеек -->
        <Style x:Key="NormalCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="White"/>
        </Style>

        <!-- Стиль для заголовков -->
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Стиль для кнопок со стрелками -->
        <Style x:Key="ArrowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="LightBlue"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Стиль для редактируемых текстовых ячеек -->
        <Style x:Key="EditableTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Стиль для TextBox в режиме редактирования -->
        <Style x:Key="EditingTextBoxStyle" TargetType="TextBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <!-- Стиль для разделенных чисел в нижней части -->
        <Style x:Key="SplitNumberStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="8"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Page.Resources>


    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
            <StackPanel 
                Orientation="Horizontal"
                HorizontalAlignment="Stretch"
                Margin="10">
                <Button 
                    x:Name="CreateButton" 
                    Command="{Binding CreateNewFileCommand}"
                    Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="10"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE710;"/>
                        <TextBlock 
                            Margin="8,0,0,0" 
                            Text="{x:Static lang:Language.CreateButton}"/>
                    </StackPanel>
                </Button>
                <Button 
                    x:Name="OpenButton" 
                    Command="{Binding OpenFileCommand}"
                    Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock 
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE8E5;"/>
                        <TextBlock 
                            Margin="8,0,0,0"
                            Text="{x:Static lang:Language.OpenButton}"/>
                    </StackPanel>
                </Button>
                <Button 
                    x:Name="SaveButton" 
                    Command="{Binding SaveFileCommand}"
                    Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock 
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE74E;"/>
                        <TextBlock 
                            Margin="8,0,0,0"
                            Text="{x:Static lang:Language.SaveButton}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid
                HorizontalAlignment="Stretch"
                Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <controls:LabeledTextBoxControl
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    LabelText="Длина трубы"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    LabelText="Установка Y"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="2"
                    Margin="10,0,10,0"
                    LabelText="Расчётный остаток"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"/>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="4*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Label
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="№"/>
                <Separator
                    Grid.Column="1"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="5,0,5,0"
                    VerticalAlignment="Stretch"/>
                <StackPanel
                    Grid.Column="2"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                    <Label
                        HorizontalContentAlignment="Center"
                        Content="Подача Y"/>
                    <Button
                        HorizontalAlignment="Stretch"
                        Content="Speed"/>
                </StackPanel>
                <Separator
                    Grid.Column="3"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <StackPanel
                    Grid.Column="4"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                    <Label
                        HorizontalContentAlignment="Center"
                        Content="Поворот B"/>
                    <Button
                        HorizontalAlignment="Stretch"
                        Content="Speed"/>
                </StackPanel>
                <Separator
                    Grid.Column="5"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <Label
                    Grid.Column="6"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    HorizontalContentAlignment="Center"
                    Content="Гиб C"/>
                <Button
                    Grid.Column="6"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Content="Speed"/>
                <Button
                    Grid.Column="7"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Content="Коэффициент"/>
                <Separator
                    Grid.Column="8"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <StackPanel
                    Grid.Column="9"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                    <Label
                        HorizontalContentAlignment="Center"
                        Content="Радиус R"/>
                    <Button
                        HorizontalAlignment="Stretch"
                        Content="Режим"/>
                </StackPanel>
                <Separator
                    Grid.Column="10"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <Label
                    Grid.Column="11"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    HorizontalContentAlignment="Center"
                    Content="Отвод Y"/>
                <Button
                    Grid.Column="11"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Content="B"/>
                <Button
                    Grid.Column="12"
                    Grid.Row="1"
                    HorizontalAlignment="Stretch"
                    Content="Y2"/>
            </Grid>
