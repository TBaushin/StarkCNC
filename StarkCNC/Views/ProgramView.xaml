<Page x:Class="StarkCNC.Views.ProgramView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:vm="clr-namespace:StarkCNC.ViewModels"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:controls="clr-namespace:StarkCNC.Controls"
      xmlns:lang="clr-namespace:StarkCNC.Localization"
      xmlns:helix="http://helix-toolkit.org/wpf"
      xmlns:local="clr-namespace:StarkCNC.Views"
      d:DataContext="{d:DesignInstance vm:ProgramViewModel}"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="{x:Static lang:Language.ProgramPageTitle}">

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.5*"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Orientation="Horizontal"
                HorizontalAlignment="Stretch"
                Margin="0,0,10,0">
                <Button 
                    x:Name="CreateButton" 
                    Command="{Binding CreateNewFileCommand}"
                    Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="10"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE710;"/>
                        <TextBlock 
                            Margin="8,0,0,0" 
                            Text="{x:Static lang:Language.CreateButton}"/>
                    </StackPanel>
                </Button>
                <Button 
                    x:Name="OpenButton" 
                    Command="{Binding OpenFileCommand}"
                    Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock 
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE8E5;"/>
                        <TextBlock 
                            Margin="8,0,0,0"
                            Text="{x:Static lang:Language.OpenButton}"/>
                    </StackPanel>
                </Button>
                <Button 
                    x:Name="SaveButton" 
                    Command="{Binding SaveFileCommand}"
                    Margin="10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock 
                            VerticalAlignment="Center"
                            FontSize="10"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE74E;"/>
                        <TextBlock 
                            Margin="8,0,0,0"
                            Text="{x:Static lang:Language.SaveButton}"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid
                Grid.Row="1"
                HorizontalAlignment="Stretch"
                Margin="0,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <controls:LabeledTextBoxControl
                    Grid.Column="0"
                    Margin="10,0,10,0"
                    LabelText="Длина трубы"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"
                    TextBoxText="{Binding PipeLength, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="1"
                    Margin="10,0,10,0"
                    LabelText="Установка Y"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"
                    TextBoxText="{Binding YSetup, Mode=TwoWay}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="2"
                    Margin="10,0,10,0"
                    LabelText="Расчётный остаток"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"
                    TextBoxText="{Binding EstimatedRemainingLength, Mode=TwoWay}"/>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="4*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Separator
                    Grid.Column="0"
                    Grid.Row="0"
                    Margin="4,0,4,0"
                    VerticalAlignment="Stretch"
                    Visibility="Hidden"/>
                <Label
                    Grid.Column="1"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Content="№"/>
                <Separator
                    Grid.Column="2"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="4,0,4,0"
                    VerticalAlignment="Stretch"/>
                <StackPanel
                    Grid.Column="3"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                    <Label
                        HorizontalContentAlignment="Center"
                        Content="Подача Y"/>
                    <Button
                        HorizontalAlignment="Stretch"
                        Content="Speed"
                        Command="{Binding SetSupplySpeedToAllCommand}"/>
                </StackPanel>
                <Separator
                    Grid.Column="4"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <StackPanel
                    Grid.Column="5"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                    <Label
                        HorizontalContentAlignment="Center"
                        Content="Поворот B"/>
                    <Button
                        HorizontalAlignment="Stretch"
                        Content="Speed"
                        Command="{Binding SetRotationSpeedToAllCommand}"/>
                </StackPanel>
                <Separator
                    Grid.Column="6"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <Label
                    Grid.Column="7"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    HorizontalContentAlignment="Center"
                    Content="Гиб C"/>
                <Button
                    Grid.Column="7"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Stretch"
                    Content="Speed"
                    Command="{Binding SetBendSpeedToAllCommand}"/>
                <Button
                    Grid.Column="8"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Stretch"
                    Content="Коэффициент"
                    Command="{Binding SetBendCoefficientToAllCommand}"/>
                <Separator
                    Grid.Column="9"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <StackPanel
                    Grid.Column="10"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                    <Label
                        HorizontalContentAlignment="Center"
                        Content="Радиус R"/>
                    <Button
                        HorizontalAlignment="Stretch"
                        Content="Режим"
                        Command="{Binding SetRadiusModeToAllCommand}"/>
                </StackPanel>
                <Separator
                    Grid.Column="11"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Margin="3,0,3,0"
                    VerticalAlignment="Stretch"/>
                <Label
                    Grid.Column="12"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    HorizontalContentAlignment="Center"
                    Content="Отвод Y"/>
                <Button
                    Grid.Column="12"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Stretch"
                    Content="B"
                    Command="{Binding SetOffsetSpeedToAllCommand}"/>
                <Button
                    Grid.Column="13"
                    Grid.Row="1"
                    Margin="5,0,5,0"
                    HorizontalAlignment="Stretch"
                    Content="Y2"
                    Command="{Binding SetOffsetCoefficientToAllCommand}"/>
                <Separator
                    Grid.Column="14"
                    Grid.Row="0"
                    Margin="4,0,4,0"
                    VerticalAlignment="Stretch"
                    Visibility="Hidden"/>
            </Grid>
            <ScrollViewer Grid.Row="3" Margin="0,10,0,10">
                <ItemsControl ItemsSource="{Binding BendingDatas}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,4,0,4"
                                MinHeight="80"
                                CornerRadius="4"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel
                                    Margin="0,4,0,4"
                                    Orientation="Vertical">
                                    <Separator
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Stretch"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="4*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Separator
                                            Grid.Column="0"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Stretch"/>
                                        <Label
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Content="{Binding Id}"/>
                                        <Separator
                                            Grid.Column="2"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Stretch"/>
                                        <Grid
                                            Grid.Column="3"
                                            Margin="0,2,0,2">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <controls:LabeledTextBoxControl
                                                Grid.Row="0"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                TextChanged="Input_TextChanged"
                                                TextBoxText="{Binding Supply, StringFormat={}{0} мм, Mode=TwoWay}"/>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Row="1"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                TextChanged="Input_TextChanged"
                                                Text="{Binding SupplySpeed, StringFormat={}{0}%, Mode=TwoWay}"/>
                                        </Grid>
                                        <Separator
                                            Grid.Column="4"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Stretch"/>
                                        <StackPanel
                                            Grid.Column="5"
                                            Margin="0,2,0,2"
                                            Orientation="Vertical">
                                            <controls:LabeledTextBoxControl
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                TextChanged="Input_TextChanged"
                                                TextBoxText="{Binding RotationAngle, StringFormat={}{0}°, Mode=TwoWay}"/>
                                            <controls:PrefixedTextBoxControl
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                TextChanged="Input_TextChanged"
                                                Text="{Binding RotationSpeed, StringFormat={}{0}%, Mode=TwoWay}"/>
                                        </StackPanel>
                                        <Separator
                                            Grid.Column="6"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Stretch"/>
                                        <Grid Grid.Column="7"
                                                Grid.ColumnSpan="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <controls:LabeledTextBoxControl
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Grid.Row="0"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                TextChanged="Input_TextChanged"
                                                TextBoxText="{Binding BendingAngle, StringFormat={}{0}°, Mode=TwoWay}"/>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Column="0"
                                                Grid.Row="1"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                TextChanged="Input_TextChanged"
                                                Text="{Binding BendingAngleSpeed, StringFormat={}{0}%, Mode=TwoWay}"/>
                                            <Separator
                                                Grid.Column="1"
                                                Grid.Row="1"
                                                Margin="3,0,3,0"
                                                VerticalAlignment="Stretch"/>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Column="2"
                                                Grid.Row="1"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="C:"
                                                TextChanged="Input_TextChanged"
                                                Text="{Binding BendingAngleCoefficient, StringFormat={}{0}°, Mode=TwoWay}"/>
                                        </Grid>
                                        <Separator
                                            Grid.Column="9"
                                            Margin="3,0,3,0"
                                            VerticalAlignment="Stretch"/>
                                        <StackPanel
                                            Grid.Column="10"
                                            Orientation="Vertical"
                                            Margin="0,2,0,2">
                                            <controls:LabeledTextBoxControl
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                TextChanged="Input_TextChanged"
                                                TextBoxText="{Binding BendingRadius, StringFormat={}{0} мм, Mode=TwoWay}"/>
                                            <ComboBox
                                                Margin="0,5,0,5"
                                                SelectedItem="{Binding BendingRadiusMode, Mode=TwoWay}">
                                                <!--ItemsSource="{Binding DataContext.BendModeList, RelativeSource={RelativeSource AncestorType=Page}}"-->
                                                <ComboBoxItem>Режим гибки</ComboBoxItem>
                                                <ComboBoxItem>Гибка</ComboBoxItem>
                                                <ComboBoxItem>Пробивка 1</ComboBoxItem>
                                                <ComboBoxItem>Пробивка 2</ComboBoxItem>
                                                <ComboBoxItem>Перехват</ComboBoxItem>
                                                <ComboBoxItem>Спираль</ComboBoxItem>
                                                <ComboBoxItem>Гибка с уездом</ComboBoxItem>
                                            </ComboBox>
                                        </StackPanel>
                                        <Separator
                                            Grid.Column="11"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Stretch"/>
                                        <Grid Grid.Column="12"
                                                Grid.ColumnSpan="2"
                                                Margin="0,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <controls:LabeledTextBoxControl
                                                Grid.Column="0"
                                                Grid.ColumnSpan="3"
                                                Grid.Row="0"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                TextChanged="Input_TextChanged"
                                                TextBoxText="{Binding Offset, StringFormat={}{0} мм, Mode=TwoWay}"/>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Column="0"
                                                Grid.Row="1"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="Sp:"
                                                TextChanged="Input_TextChanged"
                                                Text="{Binding OffsetSpeed, StringFormat={}{0}°, Mode=TwoWay}"/>
                                            <Separator
                                                Grid.Column="1"
                                                Grid.Row="1"
                                                Margin="3,0,3,0"
                                                VerticalAlignment="Stretch"/>
                                            <controls:PrefixedTextBoxControl
                                                Grid.Column="2"
                                                Grid.Row="1"
                                                Margin="0,5,0,5"
                                                NeedCallNumberInput="True"
                                                IsNumericOnly="True"
                                                Prefix="C:"
                                                TextChanged="Input_TextChanged"
                                                Text="{Binding OffsetCoefficient, StringFormat={}{0} мм, Mode=TwoWay}"/>
                                        </Grid>
                                        <Separator
                                            Grid.Column="14"
                                            Margin="4,0,4,0"
                                            VerticalAlignment="Stretch"/>
                                    </Grid>
                                    <Separator
                                        Margin="5,0,5,0"
                                        VerticalAlignment="Stretch"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button
                Grid.Row="4"
                Margin="7,0,0,10"
                Command="{Binding AddBendingDataCommand}">
                <StackPanel Orientation="Horizontal">
                    <Label
                        VerticalAlignment="Center"
                        FontSize="10"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Content=""/>
                    <Label
                        Margin="8,0,0,0"
                        Content="{x:Static lang:Language.AddButton}"/>
                </StackPanel>
            </Button>
        </Grid>
        <Border 
            Grid.Column="1" 
            Margin="10,10,0,10"
            Padding="5,5,5,5"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <helix:HelixViewport3D 
                    x:Name="BendingView"
                    Grid.Row="0"
                    ViewCubeHeight="175"
                    ViewCubeWidth="175"
                    ViewCubeVerticalPosition="Bottom"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    RenderOptions.EdgeMode="Unspecified"
                    IsManipulationEnabled="True"
                    IsViewCubeEdgeClicksEnabled="True">
                    <helix:HelixViewport3D.Camera>
                        <PerspectiveCamera
                            Position="-1571,4801,3774"
                            LookDirection="2038,-5200,-2930"
                            UpDirection="-0.145,0.372,0.917"/>
                    </helix:HelixViewport3D.Camera>
                    <helix:HelixViewport3D.Background>
                        <LinearGradientBrush 
                            StartPoint="0.5,0"
                            EndPoint="0.5,1">
                            <GradientStop Color="#FF060A13" Offset="0"/>
                            <GradientStop Color="#FF1D64FF" Offset="1"/>
                        </LinearGradientBrush>
                    </helix:HelixViewport3D.Background>
                    <helix:DefaultLights/>
                </helix:HelixViewport3D>
                <Grid
                    Grid.Row="1"
                    Margin="0,10,10,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="ZoomIn"
                        HorizontalAlignment="Left"
                        Grid.Column="0"
                        Click="ZoomIn_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE8A3;"/>
                    </Button>
                    <Button
                        x:Name="ZoomOut"
                        HorizontalAlignment="Right"
                        Grid.Column="1"
                        Click="ZoomOut_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE71F;"/>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
