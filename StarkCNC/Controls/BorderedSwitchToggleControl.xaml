<UserControl x:Class="StarkCNC.Controls.BorderedSwitchToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StarkCNC.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             MinHeight="80">
    <Border
        Margin="8,4,8,4"
        CornerRadius="4"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <local:SwitchToggleControl
            Grid.Column="1"
            Margin="20,10,20,10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            TextContent="{Binding TextContent, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"
            IsChecked="{Binding IsChecked, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Border>
</UserControl>
