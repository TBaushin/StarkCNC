<UserControl x:Class="StarkCNC.Controls.SwitchToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StarkCNC.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid ColumnDefinitions="*,Auto">
        <Label
            Grid.Column="0"
            Margin="0,0,5,0"
            VerticalAlignment="Center"
            Content="{Binding TextContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <Border
            x:Name="SwitchBorder"
            Grid.Column="1"
            VerticalAlignment="Center"
            HorizontalAlignment="Stretch"
            MouseEnter="SwitchBorder_MouseEnter"
            MouseLeave="SwitchBorder_MouseLeave">
            <Ellipse x:Name="SwitchEllipse"/>
        </Border>
    </Grid>
</UserControl>
