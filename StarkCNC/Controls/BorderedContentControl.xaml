<UserControl x:Class="StarkCNC.Controls.BorderedContentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StarkCNC.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border
        Margin="8,4,8,4"
        CornerRadius="4"
        MouseEnter="Border_MouseEnter"
        MouseLeave="Border_MouseLeave"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <ContentPresenter Content="{Binding BorderedContent, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Border>
</UserControl>
