<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:svg="http://sharpvectors.codeplex.com/svgc/"
    xmlns:lang="clr-namespace:StarkCNC.Localization"
    xmlns:local="clr-namespace:StarkCNC.Controls"
    x:Class="StarkCNC.Controls.FloorControl"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800">
    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <svg:SvgViewbox
            Grid.Column="0"
            Width="32"
            Height="32"
            Source="Resources/Icons/bending-roller-2.svg"/>
        <StackPanel
            Grid.Column="1"
            Margin="10,0,10,0"
            Orientation="Vertical"
            VerticalAlignment="Center">
            <Label Content="{Binding FloorText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Label x:Name="SelectedAdjustmentLabel"/>
        </StackPanel>
        <local:SwitchToggleControl
            Grid.Column="2"
            IsChecked="{Binding IsChecked, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <TextBlock
            Grid.Column="3"
            VerticalAlignment="Center"
            Margin="10,4,4,4"
            FontFamily="{StaticResource SymbolThemeFontFamily}"
            FontSize="20"
            Text="&#xE76C;"
            MouseEnter="TextBlock_MouseEnter"
            MouseLeave="TextBlock_MouseLeave"
            MouseLeftButtonDown="TextBlock_MouseLeftButtonDown"/>
    </Grid>
</UserControl>