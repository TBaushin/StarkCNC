<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:StarkCNC.Controls"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    x:Class="StarkCNC.Controls.FloorControl"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <CheckBox
            x:Name="FloorCheckBox"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Content="{Binding FloorText, RelativeSource={RelativeSource AncestorType=UserControl}}" Width="30"
            Click="FloorCheckBox_Click"/>

        <Image
            x:Name="RollerImage"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Grid.Column="1"/>

        <Grid Grid.Column="2"
              x:Name="GridAdjustment">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <syncfusion:SfTextBoxExt
                Grid.Column="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                SearchItemPath="{Binding SearchItemPath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                AutoCompleteMode="Suggest"
                AutoCompleteSource="{Binding AutoCompleteSource, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <local:LabeledTextBoxControl
                Grid.Column="1"
                LabelText="Диаметр трубы"
                TextBoxText="{Binding PipeDiameter, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Grid>
    </Grid>
</UserControl>