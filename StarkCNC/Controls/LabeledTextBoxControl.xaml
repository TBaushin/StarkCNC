<UserControl x:Class="StarkCNC.Controls.LabeledTextBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StarkCNC.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label
            Grid.Row="0"
            Content="{Binding LabelText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        <TextBox
            x:Name="InputTextBox"
            Grid.Row="1"
            IsReadOnly="{Binding IsReadOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"
            MouseLeftButtonDown="InputTextBox_MouseDown"
            PreviewTextInput="InputTextBox_PreviewTextInput"
            Text="{Binding TextBoxText, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    </Grid>
</UserControl>
