<UserControl x:Class="StarkCNC.Controls.RepeatButtonWithIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StarkCNC.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <RepeatButton
            x:Name="IndicatorButton"
            Grid.Column="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Content="{Binding ButtonContent, RelativeSource={RelativeSource AncestorType=UserControl}}"
            Interval="{Binding Interval, RelativeSource={RelativeSource AncestorType=UserControl}}"
            PreviewMouseDown="RepeatButton_MouseDown"
            PreviewMouseUp="RepeatButton_MouseUp"/>
        <Border Grid.Column="1" Margin="5" CornerRadius="5">
            <Rectangle>
                <Rectangle.Fill>
                    <SolidColorBrush x:Name="Indicator" Color="DarkRed"/>
                </Rectangle.Fill>
            </Rectangle>
        </Border>
    </Grid>
</UserControl>
