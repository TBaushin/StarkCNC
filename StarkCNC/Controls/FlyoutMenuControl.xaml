<UserControl x:Class="StarkCNC.Controls.FlyoutMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:StarkCNC.Helpers"
             xmlns:lang="clr-namespace:StarkCNC.Localization"
             xmlns:local="clr-namespace:StarkCNC.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <helpers:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid x:Name="FlyoutMenuOpened" Visibility="{Binding MenuIsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Button
                    Width="253"
                    Margin="19,18,18,0"
                    Click="MenuButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="15"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE700;"/>
                        <TextBlock
                            Margin="8,0,0,0"
                            Text="{x:Static lang:Language.MenuButton}"/>
                    </StackPanel>
                </Button>
                <TextBox
                    x:Name="SearchBox"
                    Width="253"
                    Margin="10"/>
            </StackPanel>
            <TreeView
                x:Name="PagesTreeView"
                Grid.Row="1"
                Margin="8,8,0,0"
                SelectedItemChanged="PageList_SelectedItemChanged"
                ItemsSource="{Binding Pages, RelativeSource={RelativeSource AncestorType=UserControl}}">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Items}">
                        <StackPanel
                            MinHeight="30"
                            Orientation="Horizontal">
                            <TextBlock
                                MaxWidth="16"
                                FontSize="16"
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SymbolThemeFontFamily}"
                                Text="{Binding IconGlyph}"
                                Visibility="{Binding IconGlyph, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                            <TextBlock
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Title}"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal">
                <Button
                    Margin="10"
                    Height="40"
                    Width="40"
                    Command="{Binding GoSettingsCommand}">
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="15"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Text="&#xE713;"/>
                </Button>
                <Button
                    Margin="10"
                    Height="40"
                    Width="210"
                    HorizontalContentAlignment="Left"
                    Command="{Binding GoUsersCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="15"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE77B;"/>
                        <TextBlock Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
        <Grid
            x:Name="FlyoutMenuClosed" 
            Visibility="{Binding MenuIsOpen, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter='invert'}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Orientation="Vertical"
                HorizontalAlignment="Center">
                <Button
                    Margin="18,18,18,6"
                    Click="MenuButton_Click">
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="15"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Text="&#xE700;"/>
                </Button>
                <Button
                    Margin="18,5,18,7">
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="15"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Text="&#xE721;"/>
                </Button>
                <Separator/>
            </StackPanel>
            <ListView
                x:Name="PagesListView"
                Grid.Row="1"
                Margin="7,8,0,0"
                ItemsSource="{Binding Pages, RelativeSource={RelativeSource AncestorType=UserControl}}"
                SelectionChanged="PageList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="16"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="{Binding IconGlyph}"
                            Visibility="{Binding IconGlyph, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <Separator/>
                <Button
                    Margin="18,7,18,5"
                    Command="{Binding GoUsersCommand}">
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="15"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Text="&#xE77B;"/>
                </Button>
                <Button
                    Margin="18,5,18,10"
                    Command="{Binding GoSettingsCommand}">
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="15"
                        FontFamily="{StaticResource SymbolThemeFontFamily}"
                        Text="&#xE713;"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
