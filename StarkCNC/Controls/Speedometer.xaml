<UserControl x:Class="StarkCNC.Controls.Speedometer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StarkCNC.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <SolidColorBrush x:Key="backgroundColorBrush" Color="White"/>
        <SolidColorBrush x:Key="fillColorBrush" Color="Green"/>
    </UserControl.Resources>
    <Grid>
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Height="305"
            Width="610"
            BorderBrush="Black"
            BorderThickness="2,2,2,0"
            CornerRadius="300,300,0,0"
            Background="White"/>
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Height="297"
            Width="594"
            BorderBrush="Green"
            BorderThickness="6,6,6,0"
            CornerRadius="300,300,0,0"
            Background="White"/>
        <Canvas x:Name="mainCanvas">
            <Path
                x:Name="orangePath"
                Fill="Orange" 
                RenderTransformOrigin="0.5,0.5"
                Canvas.Left="250"
                Canvas.Top="300">
                <Path.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="90"/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigureCollection>
                                <PathFigure
                                    StartPoint="0,300" 
                                    IsClosed="False">
                                    <PathFigure.Segments>
                                        <PathSegmentCollection>
                                            <ArcSegment
                                                Size="50,50"
                                                RotationAngle="0" 
                                                IsLargeArc="False" 
                                                SweepDirection="Clockwise" 
                                                Point="600,300"/>
                                            <LineSegment Point="575,300"/>
                                            <ArcSegment
                                                Size="50,50"
                                                RotationAngle="0"
                                                IsLargeArc="False"
                                                SweepDirection="Counterclockwise"
                                                Point="25,300"/>
                                            <LineSegment Point="0,300"/>
                                        </PathSegmentCollection>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathFigureCollection>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <Path
                x:Name="greenPath"
                Fill="Green"
                RenderTransformOrigin="0.5,0.5"
                Canvas.Left="100"
                Canvas.Top="150">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform
                            x:Name="greenPathhRT"
                            Angle="90"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigureCollection>
                                <PathFigure
                                    StartPoint="0,300" 
                                    IsClosed="False">
                                    <PathFigure.Segments>
                                        <PathSegmentCollection>
                                            <ArcSegment
                                                Size="50,50"
                                                RotationAngle="0" 
                                                IsLargeArc="False" 
                                                SweepDirection="Counterclockwise" 
                                                Point="600,300"/>
                                            <LineSegment Point="575,300"/>
                                            <ArcSegment
                                                Size="50,50"
                                                RotationAngle="0" 
                                                IsLargeArc="False" 
                                                SweepDirection="Clockwise" 
                                                Point="25,300"/>
                                            <LineSegment Point="0,300"/>
                                        </PathSegmentCollection>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathFigureCollection>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <Path
                x:Name="redPath"
                Fill="Red"
                RenderTransformOrigin="0.5,0.5"
                Canvas.Left="100"
                Canvas.Top="150">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform
                            x:Name="redPathRT"
                            Angle="315"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Path.RenderTransform>
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigureCollection>
                                <PathFigure
                                    StartPoint="0,300" 
                                    IsClosed="False">
                                    <PathFigure.Segments>
                                        <PathSegmentCollection>
                                            <ArcSegment
                                                Size="50,50"
                                                RotationAngle="0" 
                                                IsLargeArc="False" 
                                                SweepDirection="Counterclockwise" 
                                                Point="600,300"/>
                                            <LineSegment Point="575,300"/>
                                            <ArcSegment
                                                Size="50,50"
                                                RotationAngle="0" 
                                                IsLargeArc="False" 
                                                SweepDirection="Clockwise" 
                                                Point="25,300"/>
                                            <LineSegment Point="0,300"/>
                                        </PathSegmentCollection>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathFigureCollection>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Canvas>
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Height="270"
            Width="545"
            BorderBrush="Black"
            BorderThickness="2"
            CornerRadius="300,300,0,0">
            <Border.Effect>
                <DropShadowEffect Color="#FFFFC7A7" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
        </Border>
        <TextBlock
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            FontSize="80"
            FontFamily="Agency FB"
            Foreground="Black"
            Text="50">
        </TextBlock>
        <Border
            Width="5"
            CornerRadius="120,120,0,0"
            Background="Black"
            RenderTransformOrigin="0.5 2"
            Height="135"
            Margin="0 0 0 125"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="{Binding Path=Angle}"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Color="#FFB9B9B9" ShadowDepth="0"/>
            </Border.Effect>
        </Border>
    </Grid>
</UserControl>