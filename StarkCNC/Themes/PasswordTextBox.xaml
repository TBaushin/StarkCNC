<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StarkCNC.Controls">
    <Style TargetType="{x:Type local:PasswordTextBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PasswordTextBox}">
                    <Grid ColumnDefinitions="*,Auto">
                        <PasswordBox
                            x:Name="Pb"
                            Grid.Column="0"
                            BorderThickness="0"
                            Padding="4,8"
                            Height="31"/>
                        <TextBox
                            x:Name="PbTb"
                            Grid.Column="0"
                            BorderThickness="0"
                            Padding="4,8"
                            Height="31"
                            Text="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                        <Border
                            x:Name="ShowBtnBorder"
                            Grid.Column="1"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            Padding="5,6"
                            CornerRadius="0,4,4,0"
                            Height="30"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="ShowBtn"
                                FontFamily="{DynamicResource SymbolThemeFontFamily}"
                                Text="&#xE890;"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                IsHitTestVisible="False"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPassword" Value="True">
                            <Setter TargetName="Pb" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="PbTb" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="ShowBtn" Property="Text" Value="&#xED1A;"/>
                        </Trigger>
                        <Trigger Property="ShowPassword" Value="False">
                            <Setter TargetName="Pb" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PbTb" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ShowBtn" Property="Text" Value="&#xE890;"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>