<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utilities="clr-namespace:StarkCNC.Utilities;assembly=StarkCNC.Utilities"
                    xmlns:local="clr-namespace:StarkCNC.Controls">
    <utilities:EmptyToVisibilityConverter x:Key="EmptyToVisibilityConverter"/>
    
    <Style TargetType="{x:Type local:StatusBar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:StatusBar}">
                    <Grid ColumnDefinitions="4*,*">
                        <Grid
                            Grid.Column="0"
                            ColumnDefinitions="Auto,6*,*">
                            <Border
                                x:Name="CounterBorder"
                                Grid.Column="0"
                                CornerRadius="5"
                                Visibility="{Binding Statuses, Converter={StaticResource EmptyToVisibilityConverter}}">
                                <Label
                                    Margin="6,0,7,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CurrentStatusIndex, RelativeSource={RelativeSource TemplatedParent}}"/>
                                        <TextBlock Text="/"/>
                                        <TextBlock Text="{Binding StatusesCount, RelativeSource={RelativeSource TemplatedParent}}"/>
                                    </StackPanel>
                                </Label>
                            </Border>
                            
                            <Label
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{Binding CurrentStatus.Text, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Label
                                Grid.Column="2"
                                Margin="0,0,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Content="{Binding CurrentTime, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Grid>
                        <Button
                            x:Name="HistoryButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Content="История"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>