<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StarkCNC.Controls">
    <Style TargetType="{x:Type local:PersonPictureControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PersonPictureControl}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            x:Name="PictureEllipse"
                            Grid.RowSpan="3"
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Stretch="Uniform"
                            Stroke="{DynamicResource FocusStrokeColorOuterBrush}"
                            StrokeThickness="1"
                            ToolTip="{Binding DisplayName, RelativeSource={RelativeSource TemplatedParent}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding PictureSource, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse
                            Grid.RowSpan="3"
                            Grid.ColumnSpan="3"
                            Panel.ZIndex="-1"
                            Fill="{TemplateBinding Background}"
                            Stroke="{TemplateBinding BorderBrush}"
                            StrokeThickness="{TemplateBinding StrokeThickness}"
                            ToolTip="{Binding DisplayName, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <TextBlock
                            x:Name="InitialsTextBlock"
                            Grid.RowSpan="3"
                            Grid.ColumnSpan="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="36"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{Binding DisplayName, RelativeSource={RelativeSource TemplatedParent}}"
                            Visibility="Collapsed"/>
                        <Ellipse
                            x:Name="StatusEllipse"
                            Grid.Row="2"
                            Grid.Column="2"
                            MinWidth="5"
                            MinHeight="5"
                            Margin="0,0,3,3"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            ToolTip="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding StatusPictureSource, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>