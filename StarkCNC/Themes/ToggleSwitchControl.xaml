<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:StarkCNC.Controls">
    <Style TargetType="{x:Type local:ToggleSwitchControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ToggleSwitchControl}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Content="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Border
                            x:Name="ToggleSwitchBorder"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Stretch"
                            CornerRadius="10"
                            Cursor="Hand"
                            MinWidth="40"
                            MaxWidth="40">
                            <Ellipse x:Name="ToggleSwitchEllipse"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ToggleSwitchBorder" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <Setter TargetName="ToggleSwitchBorder" Property="BorderBrush" Value="{x:Null}"/>
                            <Setter TargetName="ToggleSwitchBorder" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="ToggleSwitchBorder" Property="MinHeight" Value="21"/>
                            <Setter TargetName="ToggleSwitchBorder" Property="MaxHeight" Value="21"/>

                            <Setter TargetName="ToggleSwitchEllipse" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            <Setter TargetName="ToggleSwitchEllipse" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="ToggleSwitchEllipse" Property="Margin" Value="4"/>
                            <Setter TargetName="ToggleSwitchEllipse" Property="Width" Value="13"/>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="ToggleSwitchBorder" Property="Background" Value="{DynamicResource ControlAltFillColorTertiaryBrush}"/>
                            <Setter TargetName="ToggleSwitchBorder" Property="BorderBrush" Value="{DynamicResource ControlAltFillColorQuarternaryBrush}"/>
                            <Setter TargetName="ToggleSwitchBorder" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="ToggleSwitchBorder" Property="MinHeight" Value="22"/>
                            <Setter TargetName="ToggleSwitchBorder" Property="MaxHeight" Value="22"/>

                            <Setter TargetName="ToggleSwitchEllipse" Property="Fill" Value="{DynamicResource ControlStrongFillColorDefaultBrush}"/>
                            <Setter TargetName="ToggleSwitchEllipse" Property="HorizontalAlignment" Value="Left"/>
                            <Setter TargetName="ToggleSwitchEllipse" Property="Margin" Value="3"/>
                            <Setter TargetName="ToggleSwitchEllipse" Property="Width" Value="14"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>