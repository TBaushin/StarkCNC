<Window x:Class="StarkCNC.AdjustmentParametersSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:StarkCNC.Controls"
        xmlns:lang="clr-namespace:StarkCNC.Localization"
        xmlns:local="clr-namespace:StarkCNC"
        mc:Ignorable="d"
        Title="AdjustmentParametersSettingsWindow"
        Height="690" Width="530"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <StackPanel Margin="20,0,20,0">
        <TextBlock
            x:Name="TitleTextBlock"
            Margin="0,32,0,24"
            Style="{DynamicResource TitleTextBlockStyle}"/>
        <Grid Margin="0,-10,0,15" ColumnDefinitions="*,2*">
            <Label
                Grid.Column="0"
                Margin="0,5,0,0"
                VerticalContentAlignment="Stretch"
                Content="Текущее положение:"/>
            <TextBox
                x:Name="CurrentPosition"
                Grid.Column="1"
                Margin="0,0,0,16"
                IsReadOnly="True"
                Foreground="Red"
                HorizontalAlignment="Left"
                Text="{Binding CurrentPositionCoordinate, StringFormat=N2}"/>
        </Grid>
        <Grid
            x:Name="SupplyStackPanel"
            Visibility="Collapsed"
            ColumnDefinitions="*,0.6*"
            RowDefinitions="*,*,*">
            <controls:LabeledTextBoxControl
                x:Name="SupplyPressZone"
                Grid.Column="0"
                Grid.Row="0"
                Margin="0,0,0,16"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                LabelText="Положение зоны прижима"
                Text="{Binding Adjustment.Supply.PressZonePosition, Mode=TwoWay, StringFormat=N2}"/>
            <controls:LabeledTextBoxControl
                x:Name="SupplyForwardDangerZonePosition"
                Grid.Column="0"
                Grid.Row="1"
                Margin="0,0,0,16"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                LabelText="Положение передней опасной зоны"
                Text="{Binding Adjustment.Supply.ForwardDangerZonePosition, Mode=TwoWay, StringFormat=N2}"/>
            <controls:LabeledTextBoxControl
                x:Name="SupplyColletJawsDepth"
                Grid.Column="0"
                Grid.Row="2"
                Margin="0,0,0,16"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                LabelText="Глубина губок цанги"
                Text="{Binding Adjustment.Supply.ColletJawsDepth, Mode=TwoWay, StringFormat=N2}"/>
            <Button
                x:Name="SupplyPressZoneSetCurrentPositionButton"
                Grid.Column="1"
                Grid.Row="0"
                Margin="0,-13,0,0"
                HorizontalAlignment="Right"
                Click="SupplyPressZoneSetCurrentPositionButton_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
            <Button
                x:Name="SupplyForwardDangerZoneSetCurrentPositionButton"
                Grid.Column="1"
                Grid.Row="1"
                Margin="0,-7,0,0"
                HorizontalAlignment="Right"
                Click="SupplyForwardDangerZoneSetCurrentPositionButton_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
        </Grid>
        <Grid
            x:Name="ConsoleStackPanel"
            Visibility="Collapsed"
            ColumnDefinitions="*,0.6*"
            RowDefinitions="*,*,*,*">
            <controls:LabeledTextBoxControl
                x:Name="ConsoleBendPosition"
                Grid.Column="0"
                Grid.Row="0"
                Margin="0,0,0,16"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                LabelText="Положение консоли для гибки"
                Text="{Binding Adjustment.Console.BendPosition, Mode=TwoWay, StringFormat=N2}"/>
            <controls:LabeledTextBoxControl
                x:Name="ConsoleSecondFloorPosition"
                Grid.Column="0"
                Grid.Row="1"
                Margin="0,0,0,16"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding Adjustment.Console.SecondFloorPosition, Mode=TwoWay, StringFormat=N2}">
                <controls:LabeledTextBoxControl.LabelText>
                    <TextBlock>
                        <Run Text="Положение консоли при переходе"/>
                        <LineBreak/>
                        <Run Text="с 1 на 2 этаж"/>
                    </TextBlock>
                </controls:LabeledTextBoxControl.LabelText>
            </controls:LabeledTextBoxControl>
            <controls:LabeledTextBoxControl
                x:Name="ConsoleThirdFloorPosition"
                Grid.Column="0"
                Grid.Row="2"
                Margin="0,0,0,16"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding Adjustment.Console.ThirdFloorPosition, Mode=TwoWay, StringFormat=N2}">
                <controls:LabeledTextBoxControl.LabelText>
                    <TextBlock>
                        <Run Text="Положение консоли при переходе"/>
                        <LineBreak/>
                        <Run Text="с 2 на 3 этаж"/>
                    </TextBlock>
                </controls:LabeledTextBoxControl.LabelText>
            </controls:LabeledTextBoxControl>
            <controls:LabeledTextBoxControl
                x:Name="ConsolePipeRotationDepartureDistance"
                Grid.Column="0"
                Grid.Row="3"
                Margin="0,0,0,16"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding Adjustment.Console.PipeRotationDepartureDistance, Mode=TwoWay, StringFormat=N2}">
                <controls:LabeledTextBoxControl.LabelText>
                    <TextBlock>
                        <Run Text="Расстояние отъезда"/>
                        <LineBreak/>
                        <Run Text="для поворота трубы"/>
                    </TextBlock>
                </controls:LabeledTextBoxControl.LabelText>
            </controls:LabeledTextBoxControl>
            <Button
                x:Name="ConsoleBendSetCurrentPosition"
                Grid.Column="1"
                Grid.Row="0"
                Margin="0,-13,0,0"
                HorizontalAlignment="Right"
                Click="ConsoleBendSetCurrentPosition_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
            <Button
                x:Name="ConsoleSecondFloorSetCurrentPosition"
                Grid.Column="1"
                Grid.Row="1"
                Margin="0,-12,0,0"
                HorizontalAlignment="Right"
                Click="ConsoleSecondFloorSetCurrentPosition_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
            <Button
                x:Name="ConsoleThirdFloorSetCurrentPosition"
                Grid.Column="1"
                Grid.Row="2"
                Margin="0,-13,0,0"
                HorizontalAlignment="Right"
                Click="ConsoleThirdFloorSetCurrentPosition_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
        </Grid>
        <StackPanel
            x:Name="RotationStackPanel"
            Visibility="Collapsed">
            <controls:LabeledTextBoxControl
                Margin="0,0,0,16"
                LabelText="Смещение поворота после поиска нуля"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding Adjustment.Rotation.OffsetAfterZeroSearch, Mode=TwoWay, StringFormat=N2}"/>
        </StackPanel>
        <StackPanel
            x:Name="BendStackPanel"
            Visibility="Collapsed">
            <Grid
                ColumnDefinitions="*,0.6*"
                RowDefinitions="*,*,*">
                <controls:LabeledTextBoxControl
                    x:Name="BendForwardPosition"
                    Grid.Column="0"
                    Margin="0,0,0,16"
                    LabelText="Ограничение переднего положения"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"
                    Direction="LeftToRigth"
                    Text="{Binding Adjustment.Bend.ForwardPositionLimitation, Mode=TwoWay, StringFormat=N2}"/>
                <Button
                    x:Name="BendForwardPositionSetCurrentPosition"
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="0,7,0,0"
                    HorizontalAlignment="Right"
                    Click="BendForwardPositionSetCurrentPosition_Click">
                    <Button.Content>
                        <TextBlock TextAlignment="Center">
                            <Run Text="Запомнить"/>
                            <LineBreak/>
                            <Run Text="текущее положение"/>
                        </TextBlock>
                    </Button.Content>
                </Button>
                <controls:LabeledTextBoxControl
                    Grid.Column="0"
                    Grid.Row="1"
                    Margin="0,0,0,16"
                    LabelText="Коэффициент скорости"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"
                    Direction="LeftToRigth"
                    Text="{Binding Adjustment.Bend.SpeedCoefficient, Mode=TwoWay, StringFormat=N2}"/>
                <controls:LabeledTextBoxControl
                    Grid.Column="0"
                    Grid.Row="2"
                    Margin="0,0,0,16"
                    LabelText="Коэффициент замедления"
                    IsNumericOnly="True"
                    NeedCallNumberInput="True"
                    Direction="LeftToRigth"
                    Text="{Binding Adjustment.Bend.SlowdownSpeed, Mode=TwoWay, StringFormat=N2}"/>
            </Grid>
        </StackPanel>
        <StackPanel
            x:Name="SqueezeStackPanel"
            Visibility="Collapsed">
            <controls:LabeledTextBoxControl
                Margin="0,0,0,16"
                LabelText="Ограничение переднего положения"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding Adjustment.Squeeze.FrontPositionLimitation, Mode=TwoWay, StringFormat=N2}"/>
        </StackPanel>
        <Grid
            x:Name="ClampDornPressStackPanel"
            Visibility="Collapsed"
            ColumnDefinitions="*,0.6*"
            RowDefinitions="*,*,*">
            <controls:LabeledTextBoxControl
                x:Name="ForwardPosition"
                Grid.Column="0"
                Grid.Row="0"
                Margin="0,0,0,16"
                LabelText="Переднее положение"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding ForwardPosition, Mode=TwoWay, StringFormat=N2}"/>
            <controls:LabeledTextBoxControl
                x:Name="MiddlePosition"
                Grid.Column="0"
                Grid.Row="1"
                Margin="0,0,0,16"
                LabelText="Среднее положение"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding MiddlePosition, Mode=TwoWay, StringFormat=N2}"/>
            <controls:LabeledTextBoxControl
                x:Name="BackwardPosition"
                Grid.Column="0"
                Grid.Row="2"
                Margin="0,0,0,16"
                LabelText="Заднее положение"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding BackwardPosition, Mode=TwoWay, StringFormat=N2}"/>
            <Button
                x:Name="ClampDornPressForwardSetCurrentPosition"
                Grid.Column="1"
                Grid.Row="0"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                Click="ClampDornPressForwardSetCurrentPosition_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
            <Button
                x:Name="ClampDornPressMiddleSetCurrentPosition"
                Grid.Column="1"
                Grid.Row="1"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                Click="ClampDornPressMiddleSetCurrentPosition_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
            <Button
                x:Name="ClampDornPressBackwardSetCurrentPosition"
                Grid.Column="1"
                Grid.Row="2"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                Click="ClampDornPressBackwardSetCurrentPosition_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
        </Grid>
        <Grid
            x:Name="LiftStackPanel"
            Visibility="Collapsed"
            ColumnDefinitions="*,0.6*"
            RowDefinitions="*,*,*">
            <controls:LabeledTextBoxControl
                x:Name="LiftUpperPosition"
                Grid.Column="0"
                Grid.Row="0"
                Margin="0,0,0,16"
                LabelText="Верхнее положение"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding Adjustment.Lift.UpperPosition, Mode=TwoWay, StringFormat=N2}"/>
            <controls:LabeledTextBoxControl
                x:Name="LiftMiddlePosition"
                Grid.Column="0"
                Grid.Row="1"
                Margin="0,0,0,16"
                LabelText="Среднее положение"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding Adjustment.Lift.MiddlePosition, Mode=TwoWay, StringFormat=N2}"/>
            <controls:LabeledTextBoxControl
                x:Name="LiftLowerPosition"
                Grid.Column="0"
                Grid.Row="2"
                Margin="0,0,0,16"
                LabelText="Нижнее положение"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding Adjustment.Lift.LowerPosition, Mode=TwoWay, StringFormat=N2}"/>
            <Button
                x:Name="LiftUpperSetCurrentPosition"
                Grid.Column="1"
                Grid.Row="0"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                Click="LiftUpperSetCurrentPosition_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
            <Button
                x:Name="LiftMiddleSetCurrentPosition"
                Grid.Column="1"
                Grid.Row="1"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                Click="LiftMiddleSetCurrentPosition_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
            <Button
                x:Name="LiftLowerSetCurrentPosition"
                Grid.Column="1"
                Grid.Row="2"
                Margin="0,7,0,0"
                HorizontalAlignment="Right"
                Click="LiftLowerSetCurrentPosition_Click">
                <Button.Content>
                    <TextBlock TextAlignment="Center">
                        <Run Text="Запомнить"/>
                        <LineBreak/>
                        <Run Text="текущее положение"/>
                    </TextBlock>
                </Button.Content>
            </Button>
        </Grid>
        <Grid x:Name="SpeedCoefficientGrid">
            <controls:LabeledTextBoxControl
                x:Name="SpeedCoefficient"
                Grid.Column="0"
                Margin="0,0,0,16"
                LabelText="Коэффициент скорости"
                IsNumericOnly="True"
                NeedCallNumberInput="True"
                Direction="LeftToRigth"
                Text="{Binding SpeedCoefficient, Mode=TwoWay, StringFormat=N2}"/>
        </Grid>
        <Grid
            ColumnDefinitions="*,*"
            Margin="0,0,0,16">
            <Button
                x:Name="Reset"
                Grid.Column="0"
                Margin="0,0,10,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Content="Обнуление"
                Click="Reset_Click"/>
            <Border
                Grid.Column="1"
                Margin="10,5,5,5"
                CornerRadius="5"
                HorizontalAlignment="Left">
                <Rectangle Width="12">
                    <Rectangle.Fill>
                        <SolidColorBrush
                            x:Name="ResetIndicator"
                            Color="{Binding ResetIndicatorColor}"/>
                    </Rectangle.Fill>
                </Rectangle>
            </Border>
            <Label
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                Foreground="Green"
                Content="Выполнено"/>
        </Grid>

        <Grid
            ColumnDefinitions="*,*"
            Margin="0,0,0,16">
            <Button
                x:Name="Backward"
                Grid.Column="0"
                Margin="0,0,10,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Content="Назад"
                PreviewMouseDown="Backward_PreviewMouseDown"
                PreviewMouseUp="Backward_PreviewMouseUp"/>
            <Button
                x:Name="Forward"
                Grid.Column="1"
                Margin="10,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Content="Вперёд"
                PreviewMouseDown="Forward_PreviewMouseDown"
                PreviewMouseUp="Forward_PreviewMouseUp"/>
        </Grid>

    </StackPanel>
</Window>
