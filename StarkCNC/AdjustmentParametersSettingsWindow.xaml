<Window x:Class="StarkCNC.AdjustmentParametersSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:StarkCNC.Controls"
        xmlns:lang="clr-namespace:StarkCNC.Localization"
        xmlns:local="clr-namespace:StarkCNC"
        mc:Ignorable="d"
        Title="AdjustmentParametersSettingsWindow"
        Height="465" Width="500"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <Grid Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="20,0,20,0" Grid.Row="0">
            <TextBlock
            x:Name="TitleTextBlock"
            Margin="0,32,0,24"
            Style="{DynamicResource TitleTextBlockStyle}"/>
            <ItemsControl
                ItemsSource="{Binding TitleValues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:LabeledTextBoxControl
                            Margin="0,0,0,16"
                            LabelText="{Binding Title}"
                            TextBoxText="{Binding Value}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <Grid
            Grid.Row="1"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SaveButton"
                Grid.Column="0"
                Margin="10,24,0,24"
                HorizontalAlignment="Center"
                Width="175"
                Style="{StaticResource AccentButtonStyle}"
                Content="Сохранить"
                Click="SaveButton_Click"/>
            <Button
                x:Name="CancelButton"
                Grid.Column="1"
                Margin="0,24,10,24"
                HorizontalAlignment="Center"
                Width="175"
                Content="Отмена"
                Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
