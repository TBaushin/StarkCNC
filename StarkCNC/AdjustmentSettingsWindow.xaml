<Window x:Class="StarkCNC.AdjustmentSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:StarkCNC.ViewModels"
        xmlns:controls="clr-namespace:StarkCNC.Controls"
        xmlns:lang="clr-namespace:StarkCNC.Localization"
        xmlns:local="clr-namespace:StarkCNC"
        mc:Ignorable="d"
        Title="AdjustmentSettingsWindow"
        Height="465" Width="500"
        ResizeMode="NoResize"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
    <Grid Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="20,0,20,0" Grid.Row="0">
            <TextBlock
                x:Name="TitleTextBlock"
                Margin="0,32,0,24"
                Style="{DynamicResource TitleTextBlockStyle}"/>
            <controls:LabeledTextBoxControl
                Margin="0,0,0,16"
                LabelText="{x:Static lang:Language.Name}"
                Text="{Binding Result.Name, Mode=TwoWay}"/>
            <controls:LabeledTextBoxControl
                Margin="0,0,0,16"
                LabelText="{x:Static lang:Language.PipeDiameter}"
                Text="{Binding Result.PipeDiameter, Mode=TwoWay}"/>
            <controls:LabeledTextBoxControl
                Margin="0,0,0,16"
                LabelText="Радиус оснастки"
                Text="{Binding Result.Radius, Mode=TwoWay}"/>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label
                    Grid.Row="0"
                    Content="Тип оснастки"/>
                <ComboBox
                    Grid.Row="1"
                    ItemsSource="{Binding Types}"
                    SelectedItem="{Binding SelectedType, Mode=TwoWay}"/>

            </Grid>
        </StackPanel>
        <Grid
            Grid.Row="1"
            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button
                x:Name="SaveButton"
                Grid.Column="0"
                Margin="10,24,0,24"
                HorizontalAlignment="Center"
                Width="175"
                Style="{StaticResource AccentButtonStyle}"
                Content="Сохранить"
                Click="SaveButton_Click"/>
            <Button
                x:Name="CancelButton"
                Grid.Column="1"
                Margin="0,24,10,24"
                HorizontalAlignment="Center"
                Width="175"
                Content="Отмена"
                Click="CancelButton_Click"/>
        </Grid>
    </Grid>
</Window>
