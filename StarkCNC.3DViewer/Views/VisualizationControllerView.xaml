<UserControl x:Class="StarkCNC._3DViewer.Views.VisualizationControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helix="http://helix-toolkit.org/wpf" 
             xmlns:lang="clr-namespace:StarkCNC._3DViewer.Localization" 
             xmlns:local="clr-namespace:StarkCNC._3DViewer.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border 
            Grid.Row="0" 
            Margin="10"
            Padding="5,5,5,5"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <helix:HelixViewport3D 
                    x:Name="BendingView"
                    Grid.Column="0"
                    ViewCubeHeight="200"
                    ViewCubeWidth="200"
                    ViewCubeVerticalPosition="Bottom"
                    RenderOptions.BitmapScalingMode="LowQuality"
                    RenderOptions.EdgeMode="Unspecified"
                    IsManipulationEnabled="True"
                    IsViewCubeEdgeClicksEnabled="True">
                    <helix:HelixViewport3D.Camera>
                        <PerspectiveCamera
                            Position="-1571,4801,3774"
                            LookDirection="2038,-5200,-2930"
                            UpDirection="-0.145,0.372,0.917"/>
                    </helix:HelixViewport3D.Camera>
                    <helix:HelixViewport3D.Background>
                        <LinearGradientBrush 
                            StartPoint="0.5,0"
                            EndPoint="0.5,1">
                            <GradientStop Color="#FF060A13" Offset="0"/>
                            <GradientStop Color="#FF1D64FF" Offset="1"/>
                        </LinearGradientBrush>
                    </helix:HelixViewport3D.Background>
                    <helix:DefaultLights/>
                </helix:HelixViewport3D>
                <StackPanel
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="10,0,10,0"
                    Orientation="Vertical">
                    <Button
                        x:Name="ZoomIn"
                        Margin="0,0,0,10"
                        Click="ZoomIn_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE8A3;"/>
                    </Button>
                    <Button
                        x:Name="ZoomOut"
                        Margin="0,0,0,10"
                        Click="ZoomOut_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE71F;"/>
                    </Button>
                    <Button
                        x:Name="Update"
                        Margin="0,0,0,10"
                        Click="StartAnimation_Click">
                        <TextBlock 
                            VerticalAlignment="Center"
                            Margin="0,4,0,0"
                            FontSize="20"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Text="&#xE75F;"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Visible"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="12">
                <Label Content="{x:Static lang:Language.Console}"/>
                <Slider
                    x:Name="ConsoleSlider"
                    Maximum="300"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    ValueChanged="Sliders_ValueChanged"/>
                <Separator/>
                <Label Content="{x:Static lang:Language.Bend}"/>
                <Slider
                    x:Name="BendSlider"
                    Maximum="195"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    ValueChanged="Sliders_ValueChanged"/>
                <Separator/>
                <Label Content="{x:Static lang:Language.Supply}"/>
                <Slider
                    x:Name="SupplySlider"
                    Maximum="3000"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    ValueChanged="Sliders_ValueChanged"/>
                <Separator/>
                <Label Content="{x:Static lang:Language.Height}"/>
                <Slider
                    x:Name="HeightSlider"
                    Maximum="180"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    ValueChanged="Sliders_ValueChanged"/>
                <Separator/>
                <Label Content="{x:Static lang:Language.Clamp}"/>
                <Slider
                    x:Name="ClampSlider"
                    Maximum="100"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    ValueChanged="Sliders_ValueChanged"/>
                <Separator/>
                <Label Content="{x:Static lang:Language.Press}"/>
                <Slider
                    x:Name="PressSlider"
                    Maximum="100"
                    LargeChange="0.1"
                    TickFrequency="0.1"
                    ValueChanged="Sliders_ValueChanged"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
